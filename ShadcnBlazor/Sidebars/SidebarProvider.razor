@using ShadcnBlazor.Interop
@inherits ShadcnBase

@inject InteropService InteropService

<div class="@Classes"
     style="@($"--sidebar-width: {SidebarWidth}; --sidebar-width-icon: {SidebarWidthIcon}")"
     @attributes="Props">
    <CascadingValue TValue="SidebarProvider" Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public bool DefaultOpen { get; set; } = true;
    [Parameter] public EventCallback<bool> OnOpenChange { get; set; }

    public bool IsMobile { get; private set; }
    public bool OpenMobile { get; set; }
    public bool IsOpen { get; private set; }
    public bool IsExpanded { get; private set; }
    
    internal Sidebar Sidebar { get; set; }

    internal const string SidebarWidth = "16rem";
    internal const string SidebarWidthMobile = "16rem";
    internal const string SidebarWidthIcon = "3rem";

    private string? Classes;

    protected override void OnInitialized()
    {
        IsOpen = DefaultOpen;
        IsExpanded = DefaultOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Enable mobile mode when smaller than tailwinds md size
        IsMobile = !await InteropService.GetMatchMediaAsync("(width >= 48rem");
        
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "group/sidebar-wrapper has-data-[variant=inset]:bg-sidebar flex min-h-svh w-full",
            ClassName
        );
    }

    public async Task ToggleSidebarAsync()
    {
        if (IsMobile)
        {
            OpenMobile = !OpenMobile;

            if (OpenMobile)
                await Sidebar.OpenMobileAsync();

            await OnOpenChange.InvokeAsync(OpenMobile);
        }
        else
        {
            IsOpen = !IsOpen;
            IsExpanded = IsOpen;

            await OnOpenChange.InvokeAsync(IsOpen);
        }

        await InvokeAsync(StateHasChanged);
    }

    internal async Task OnMobileSidebarClosed()
    {
        OpenMobile = false;
        await OnOpenChange.InvokeAsync(false);
    }
}
