@using LucideBlazor
@inherits ShadcnBase

<span
    data-slot="breadcrumb-ellipsis"
    role="presentation"
    aria-hidden="true"
    class="@Classes"
    @attributes="Props">
    
    <EllipsisIcon ClassName="size-4" />
</span>

@code
{
    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "flex size-9 items-center justify-center",
            ClassName
        );
    }
}