@inherits ShadcnBase

<div data-slot="input-otp-separator" role="separator" class="@ClassName">
    <i class="icon-minus"></i>
</div>

@code
{
    [CascadingParameter] public InputOTP? Parent { get; set; }
    
    protected override void OnParametersSet()
    {
        if (Parent is null)
            throw new NullReferenceException($"{nameof(InputOPTSeparator)} cannot be used outside of a {nameof(InputOTP)} component.");
    }
}