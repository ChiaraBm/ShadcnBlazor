@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using TailwindMerge

@inherits Microsoft.AspNetCore.Components.Forms.InputBase<TValue>

@typeparam TValue

@inject TwMerge Merge

<input @bind="Value"
       @bind:after="OnChangedAsync"
       @bind:event="@BindEvent"
       data-slot="input"
       type="text"
       @attributes="AdditionalAttributes"
       class="@Classes"/>

@code
{
    [Parameter] public string? ClassName { get; set; }
    [Parameter] public string BindEvent { get; set; } = "onchange";

    [Parameter] public string ParsingErrorMessage { get; set; } = "The {0} field must be a number.";

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Merge.Merge(
            "file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 border-input h-9 w-full min-w-0 rounded-md border bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm",
            "focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]",
            "aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive",
            ClassName,
            CssClass
        );
    }

    private async Task OnChangedAsync()
    {
        await ValueChanged.InvokeAsync(Value);
        
        // ReSharper disable once ConditionalAccessQualifierIsNonNullableAccordingToAPIContract
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (BindConverter.TryConvertTo(value, CultureInfo.InvariantCulture, out result))
        {
            validationErrorMessage = null;
            return true;
        }

        validationErrorMessage = string.Format(CultureInfo.InvariantCulture, ParsingErrorMessage, DisplayName ?? FieldIdentifier.FieldName);
        return false;
    }

    protected override string? FormatValueAsString(TValue? value)
    {
        if (value == null)
            return null;
        
        return value switch
        {
            int num1 => BindConverter.FormatValue(num1, CultureInfo.InvariantCulture),
            long num2 => BindConverter.FormatValue(num2, CultureInfo.InvariantCulture),
            short num3 => BindConverter.FormatValue(num3, CultureInfo.InvariantCulture),
            float num4 => BindConverter.FormatValue(num4, CultureInfo.InvariantCulture),
            double num5 => BindConverter.FormatValue(num5, CultureInfo.InvariantCulture),
            decimal num6 => BindConverter.FormatValue(num6, CultureInfo.InvariantCulture),
            _ => throw new InvalidOperationException($"Unsupported type {value.GetType()}")
        };
    }
}