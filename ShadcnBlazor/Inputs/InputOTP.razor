@inherits ShadcnBase

<div data-input-otp-container="true"
     class="@Classes">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
    <div style="position:absolute;inset:0;pointer-events:none">
        <input
            data-slot="input-otp"
            data-input-otp="true"
            data-input-otp-placeholder-shown="true"
            inputmode="numeric"
            class="absolute inset-0 w-full w-full fkex text-left opacity-100 text-transparent pointer-events-auto bg-transparent caret-transparent border-0 outline-0 shadow-none leading-none tracking-[-0.5em] font-mono tabular-nums"
            maxlength="@MaxLenght"
            data-input-otp-mss="0"
            data-input-otp-mse="0"
            autocomplete="off"
            spellcheck="false"
            @onfocusin="OnFocusInAsync"
            @onfocusout="OnFocusOutAsync"
            @bind:event="oninput"
            @bind:after="OnInputAsync"
            @bind="Value"
            data-disabled="@Disabled"
            disabled="@Disabled"
            @attributes="Props"/>
    </div>
</div>

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }

    [Parameter] public int MaxLenght { get; set; }
    [Parameter] public EventCallback<string> OnInputValid { get; set; }
    [Parameter] public bool Disabled { get; set; }

    public bool IsFocused { get; private set; }
    public string Value { get; private set; } = "";

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "relative flex items-center gap-2 has-disabled:opacity-50",
            ClassName
        );
    }

    private async Task OnFocusInAsync()
    {
        IsFocused = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFocusOutAsync()
    {
        IsFocused = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnInputAsync()
    {
        await InvokeAsync(StateHasChanged);

        if (Value.Length == MaxLenght)
            await OnInputValid.InvokeAsync(Value);
    }
}