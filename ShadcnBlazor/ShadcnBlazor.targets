<Project>
    <PropertyGroup>
        <ShadcnBlazorCssClassDir Condition="'$(ShadcnBlazorCssClassDir)' == ''">
            $(MSBuildProjectDirectory)\bin\ShadcnBlazor
        </ShadcnBlazorCssClassDir>
    </PropertyGroup>

    <Target Name="ShadcnBlazor_CopyContents" BeforeTargets="Build">
        <ItemGroup>
            <Files Include="$(MSBuildThisFileDirectory)..\Styles\**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(Files)" DestinationFolder="$(ShadcnBlazorCssClassDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>