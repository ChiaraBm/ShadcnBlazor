<CascadingValue TValue="Select" Value="this">
    @ChildContent
</CascadingValue>

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }
    
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string DefaultValue { get; set; }
    
    internal bool IsOpen { get; private set; }
    internal bool ShouldRenderContent { get; private set; }
    
    internal SelectTrigger Trigger { get; set; }
    internal RenderFragment ValueContent { get; private set; }

    protected override void OnInitialized()
    {
        Value = DefaultValue;
    }

    internal async Task UpdateValueAsync(string value, RenderFragment valueRender)
    {
        Value = value;
        ValueContent = valueRender;
        await ValueChanged.InvokeAsync();

        await CloseAsync();
    }

    public async Task OpenAsync()
    {
        IsOpen = true;
        ShouldRenderContent = true;

        await InvokeAsync(StateHasChanged);
    }

    public async Task CloseAsync()
    {
        IsOpen = false;
        
        await InvokeAsync(StateHasChanged).ContinueWith(async _ =>
        {
            await Task.Delay(100);

            ShouldRenderContent = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}