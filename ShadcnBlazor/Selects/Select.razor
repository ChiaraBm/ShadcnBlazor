@using ShadcnBlazor.Popovers
@typeparam T

<CascadingValue Value="this">
    <Popover @ref="Popover">
        @ChildContent
    </Popover>
</CascadingValue>

@code {

    [Parameter] public RenderFragment ChildContent { get; set; }

    private T? _value;
    
    [Parameter] public T? Value 
    { 
        get => _value; 
        set
        {
            if (value is null)
                return;
            
            if (_value is not null && KeySelector.Invoke(value) == KeySelector.Invoke(_value))
                return;
            
            _value = value;  
            
            if(ValueChanged.HasDelegate)
            {
               _ = ValueChanged.InvokeAsync(value);
            }  
        }
    }

    [Parameter] public EventCallback<T?> ValueChanged { get; set; }

    [Parameter] public Func<T, string> DisplayName { get; set; }
    
    [Parameter] public Func<T, string> KeySelector { get; set; }

    public bool Opened => Popover.IsOpen;

    internal Popover Popover;

    internal SelectValue<T> SelectValue;
}