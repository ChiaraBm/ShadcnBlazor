@if (string.IsNullOrWhiteSpace(Select.Value))
{
    <span data-slot="select-value">@Placeholder</span>
}
else
{
    <span data-slot="select-value">
        @if (Select.ValueContent == null)
        {
            @Select.Value
        }
        else
        {
            @Select.ValueContent
        }
    </span>
}

@code
{
    [CascadingParameter] public Select Select { get; set; }
    
    [Parameter] public string Placeholder { get; set; }
}