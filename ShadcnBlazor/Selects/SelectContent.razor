@using ShadcnBlazor.Interop
@using ShadcnBlazor.Popovers

@typeparam T

@inherits ShadcnBase

<PopoverContent Align="Alignment" Side="Side" ClassName="w-[200px] p-0 bg-none border-0">
    <div class="@Classes"
         role="listbox"
         data-state="@Parent.Popover.IsOpen.ToString().ToLowerInvariant()"
         data-slot="select-content">
        <div role="presentation"
             class="p-1 w-full scroll-my-1"
             style="position: relative; flex: 1 1 0%; overflow: hidden auto;">
            @ChildContent
        </div>
    </div>
</PopoverContent>

@code {
    [CascadingParameter] public Select<T>? Parent { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }

    [Parameter] public PositionAlignment Alignment { get; set; } = PositionAlignment.Start;
    [Parameter] public PositionSide Side { get; set; } = PositionSide.Bottom;
    
    private string? Classes;

    protected override void OnParametersSet()
    {
        if (Parent is null)
            throw new NullReferenceException($"{nameof(SelectTrigger<T>)} cannot be used outside of a {nameof(Select<T>)} component.");

        Classes = Cn(
            "w-full bg-popover text-popover-foreground data-[state=open]:animate-in data-[state=closed]:animate-out  data-[side=left]:slide-in-from-right-2",
            "data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[side=bottom]:slide-in-from-top-2",
            "data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 relative z-50 max-h-(--radix-select-content-available-height) min-w-[8rem]",
            "origin-(--radix-select-content-transform-origin) overflow-x-hidden overflow-y-auto rounded-md border shadow-md data-[side=bottom]:translate-y-1",
            "data-[side=left]:-translate-x-1 data-[side=right]:translate-x-1 data-[side=top]:-translate-y-1",
            ClassName);
    }
    

}