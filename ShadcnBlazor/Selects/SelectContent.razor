@using Microsoft.AspNetCore.Components.Sections
@using ShadcnBlazor.Interop
@using ShadcnBlazor.Portals

@inherits ShadcnBase

@inject PositionService PositionService
@inject InteropService InteropService

@if (Select.ShouldRenderContent)
{
    <SectionContent SectionName="@PortalNames.Select">
        <div class="fixed inset-0 z-100" @onclick="Select.CloseAsync">
        </div>

        <div @ref="PositionElement" style="@Style" class="fixed top-0 left-0 z-100">
            <div data-slot="select-content"
                 data-state="@(Select.IsOpen ? "open" : "closed")"
                 class="@Classes"
                 @attributes="Props">
                
                @if(Select.Items.TryGetValue(string.Empty, out var value))
                {
                    <SelectItem Value="@string.Empty">
                        @value
                    </SelectItem>
                }
                
                @ChildContent
            </div>
        </div>
    </SectionContent>
}
else
{
    <div class="hidden">
        @ChildContent
    </div>
}

@code
{
    [CascadingParameter] public Select Select { get; set; }

    [Parameter] public bool UseAutoWidth { get; set; } = true;
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public PositionAlignment Align { get; set; } = PositionAlignment.Start;

    private ElementReference PositionElement;
    private string PositionStyle = PositionService.Position.OffCanvasCss;
    private bool IsPositioned;

    private string? Classes;
    private double TriggerWidth;

    private string Style => UseAutoWidth ? $"{PositionStyle};width: {TriggerWidth}px" : PositionStyle;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "bg-popover text-popover-foreground data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 relative z-50 max-h-(--radix-select-content-available-height) min-w-[8rem] origin-(--radix-select-content-transform-origin) overflow-x-hidden overflow-y-auto rounded-md border shadow-md",
            ClassName
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Select.ShouldRenderContent && !IsPositioned)
        {
            var position = await PositionService.PositionAroundAsync(
                Select.Trigger.TriggerElement,
                    PositionElement,
                    PositionSide.Bottom,
                    Align
            );

            PositionStyle = position.ToCssStyle();

            if (UseAutoWidth)
            {
                var triggerBox = await InteropService.GetBoundingBoxAsync(Select.Trigger.TriggerElement);
                TriggerWidth = triggerBox.Width;
            }

            IsPositioned = true;
            await InvokeAsync(StateHasChanged);
        }
        else
            IsPositioned = false;
    }
}