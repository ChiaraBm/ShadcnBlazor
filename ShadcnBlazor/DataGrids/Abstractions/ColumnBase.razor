@using Microsoft.AspNetCore.Components.Rendering
@using ShadcnBlazor.Tabels

@typeparam TGridItem

@code
{
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? HeadClassName { get; set; }
    [Parameter] public bool DefaultVisible { get; set; } = true;

    public virtual void RenderHead(RenderTreeBuilder __builder)
    {
        <TableHead ClassName="@HeadClassName">
            @Title
        </TableHead>
    }
}
