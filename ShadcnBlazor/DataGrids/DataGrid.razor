@using LucideBlazor
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Dropdowns
@using ShadcnBlazor.Emptys
@using ShadcnBlazor.Inputs
@using ShadcnBlazor.Popovers
@using ShadcnBlazor.Spinners
@using ShadcnBlazor.Labels
@using ShadcnBlazor.Tabels

@inherits ShadcnBase

@typeparam TGridItem

<CascadingValue TValue="DataGrid<TGridItem>" IsFixed="true" Value="this">
    @ChildContent
</CascadingValue>

@if (IsInitialized)
{
    var columnsWithTitle = Columns
        .Where(x => !string.IsNullOrWhiteSpace(x.Title))
        .ToArray();

    var filterableColumns = columnsWithTitle
        .Where(x => x.IsFilterable)
        .ToArray();

    <div class="flex items-center py-4 gap-x-1.5">
        @if (EnableSearch)
        {
            <InputGroup ClassName="max-w-xs">
                <InputGroupAddon>
                    <SearchIcon/>
                </InputGroupAddon>
                @if (EnableLiveSearch)
                {
                    <InputGroupInput>
                        <Slot>
                            <input @bind="SearchTerm"
                                   @bind:event="oninput"
                                   @bind:after="OnSearchChangedAsync"
                                   placeholder="Search..."
                                   type="search"
                                   @attributes="context"/>
                        </Slot>
                    </InputGroupInput>
                }
                else
                {
                    <InputGroupInput>
                        <Slot>
                            <input @bind="SearchTerm"
                                   @bind:after="OnSearchChangedAsync"
                                   placeholder="Search..."
                                   type="search"
                                   @attributes="context"/>
                        </Slot>
                    </InputGroupInput>
                }
            </InputGroup>
        }
        <div class="ml-auto flex gap-x-1.5">
            @if (filterableColumns.Length > 0)
            {
                <Popover @ref="FilterPopover">
                    <PopoverTrigger>
                        <Slot>
                            <Button @attributes="context" Variant="ButtonVariant.Outline">
                                <SlidersHorizontalIcon />
                                <span class="hidden md:block">Filter</span>
                            </Button>
                        </Slot>
                    </PopoverTrigger>
                    <PopoverContent>
                        <div class="grid gap-2">
                            @foreach (var column in filterableColumns)
                            {
                                if (string.IsNullOrWhiteSpace(column.Title))
                                    continue;

                                <div class="grid grid-cols-3 items-center gap-4" @key="column">
                                    <Label for="@column.Title">
                                        @column.Title
                                    </Label>
                                    <InputField
                                        id="@column.Title"
                                        placeholder="Filter for..."
                                        @bind-Value="column.Filter"
                                        ClassName="col-span-2 h-8"/>
                                </div>
                            }

                            <div class="flex justify-center items-center">
                                <Button @onclick="ApplyFilterAsync"
                                        Size="ButtonSize.Sm">
                                    Apply
                                </Button>
                            </div>
                        </div>
                    </PopoverContent>
                </Popover>
            }

            @if (ColumnVisibility)
            {
                <DropdownMenu>
                    <DropdownMenuTrigger>
                        <Slot>
                            <Button Variant="ButtonVariant.Outline" @attributes="context">
                                <Columns3CogIcon/>
                                <span class="hidden md:block">Columns</span>
                            </Button>
                        </Slot>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent>
                        @foreach (var column in columnsWithTitle)
                        {
                            <DropdownMenuCheckboxItem DefaultValue="@column.IsVisible"
                                                      ValueChanged="b => SetColumnVisibleAsync(column, b)"
                                                      @key="column">
                                @column.Title
                            </DropdownMenuCheckboxItem>
                        }
                    </DropdownMenuContent>
                </DropdownMenu>
            }
        </div>
    </div>

    <div class="@Classes">
        <Table @attributes="Props">
            <TableHeader>
                <TableRow>
                    @HeaderFragment
                </TableRow>
            </TableHeader>
            <TableBody>
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="99999">
                            <div class="w-full flex items-center justify-center p-5">
                                <Spinner ClassName="size-10"/>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    if (Items.Length == 0)
                    {
                        <tr>
                            <td colspan="99999">
                                <div class="w-full flex items-center justify-center p-5">
                                    <Empty>
                                        <EmptyHeader>
                                            <EmptyMedia Variant="EmptyMediaVariant.Icon">
                                                <SearchIcon/>
                                            </EmptyMedia>
                                            <EmptyTitle>No items found</EmptyTitle>
                                            <EmptyDescription>
                                                No items have been found for your request
                                            </EmptyDescription>
                                        </EmptyHeader>
                                    </Empty>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @RowFragment

                        foreach (var item in Items)
                        {
                            <TableRow @key="item">
                                @CellFragment.Invoke(item)
                            </TableRow>
                        }
                    }
                }
            </TableBody>
        </Table>
    </div>

    <div class="flex items-center justify-end md:justify-between mt-1.5">
        <div class="hidden md:block text-muted-foreground text-sm">
            Showing @(StartIndex + 1)-@(StartIndex + Items.Length) of @(TotalItems) items
        </div>
        <div class="flex items-center gap-x-1">
            <Button disabled="@(IsLoading || CurrentPage == 0)"
                    @onclick="NavigateToStartAsync"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.IconSm">
                <ChevronsLeftIcon/>
            </Button>

            <Button disabled="@(IsLoading || CurrentPage == 0)"
                    @onclick="() => NavigateAsync(-1)"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm">
                <ChevronLeftIcon />
                <span class="hidden md:block">Previous</span>
            </Button>

            <Button disabled="@(IsLoading || CurrentPage == MaximumPage)"
                    @onclick="() => NavigateAsync(1)"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm">
                <span class="hidden md:block">Next</span>
                <ChevronRightIcon />
            </Button>
            <Button disabled="@(IsLoading || CurrentPage == MaximumPage)"
                    @onclick="NavigateToEndAsync"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.IconSm">
                <ChevronsRightIcon/>
            </Button>
        </div>
    </div>
}

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "overflow-hidden rounded-md border",
            ClassName
        );
    }
}