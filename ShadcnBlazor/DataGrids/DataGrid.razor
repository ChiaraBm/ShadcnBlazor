@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Dropdowns
@using ShadcnBlazor.Emptys
@using ShadcnBlazor.Inputs
@using ShadcnBlazor.Popovers
@using ShadcnBlazor.Spinners
@using ShadcnBlazor.Labels
@using ShadcnBlazor.Tabels

@inherits ShadcnBase

@typeparam TGridItem

<CascadingValue TValue="DataGrid<TGridItem>" IsFixed="true" Value="this">
    @ChildContent
</CascadingValue>

@if (IsInitialized)
{
    var columnsWithTitle = Columns
        .Where(x => !string.IsNullOrWhiteSpace(x.Title))
        .ToArray();

    var filterableColumns = columnsWithTitle
        .Where(x => x.IsFilterable)
        .ToArray();

    <div class="flex items-center py-4 gap-x-1.5">
        @if (EnableSearch)
        {
            <InputGroup ClassName="max-w-xs">
                <InputGroupAddon>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-search-icon lucide-search">
                        <path d="m21 21-4.34-4.34"/>
                        <circle cx="11" cy="11" r="8"/>
                    </svg>
                </InputGroupAddon>
                @if (EnableLiveSearch)
                {
                    <InputGroupInput>
                        <Slot>
                            <input @bind="SearchTerm"
                                   @bind:event="oninput"
                                   @bind:after="OnSearchChangedAsync"
                                   placeholder="Search..."
                                   type="search"
                                   @attributes="context"/>
                        </Slot>
                    </InputGroupInput>
                }
                else
                {
                    <InputGroupInput>
                        <Slot>
                            <input @bind="SearchTerm"
                                   @bind:after="OnSearchChangedAsync"
                                   placeholder="Search..."
                                   type="search"
                                   @attributes="context"/>
                        </Slot>
                    </InputGroupInput>
                }
            </InputGroup>
        }
        <div class="ml-auto flex gap-x-1.5">
            @if (filterableColumns.Length > 0)
            {
                <Popover @ref="FilterPopover">
                    <PopoverTrigger>
                        <Slot>
                            <Button @attributes="context" Variant="ButtonVariant.Outline">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round"
                                     class="lucide lucide-sliders-horizontal-icon lucide-sliders-horizontal">
                                    <path
                                        d="M10 5H3"/>
                                    <path d="M12 19H3"/>
                                    <path d="M14 3v4"/>
                                    <path d="M16 17v4"/>
                                    <path
                                        d="M21 12h-9"/>
                                    <path d="M21 19h-5"/>
                                    <path d="M21 5h-7"/>
                                    <path d="M8 10v4"/>
                                    <path
                                        d="M8 12H3"/>
                                </svg>
                                <span class="hidden md:block">Filter</span>
                            </Button>
                        </Slot>
                    </PopoverTrigger>
                    <PopoverContent>
                        <div class="grid gap-2">
                            @foreach (var column in filterableColumns)
                            {
                                if (string.IsNullOrWhiteSpace(column.Title))
                                    continue;

                                <div class="grid grid-cols-3 items-center gap-4" @key="column">
                                    <Label for="@column.Title">
                                        @column.Title
                                    </Label>
                                    <InputField
                                        id="@column.Title"
                                        placeholder="Filter for..."
                                        @bind-Value="column.Filter"
                                        ClassName="col-span-2 h-8"/>
                                </div>
                            }

                            <div class="flex justify-center items-center">
                                <Button @onclick="ApplyFilterAsync"
                                        Size="ButtonSize.Sm">
                                    Apply
                                </Button>
                            </div>
                        </div>
                    </PopoverContent>
                </Popover>
            }

            @if (ColumnVisibility)
            {
                <DropdownMenu>
                    <DropdownMenuTrigger>
                        <Slot>
                            <Button Variant="ButtonVariant.Outline" @attributes="context">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round"
                                     class="lucide lucide-columns3-cog-icon lucide-columns-3-cog">
                                    <path d="M10.5 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5.5"/>
                                    <path d="m14.3 19.6 1-.4"/>
                                    <path d="M15 3v7.5"/>
                                    <path d="m15.2 16.9-.9-.3"/>
                                    <path d="m16.6 21.7.3-.9"/>
                                    <path d="m16.8 15.3-.4-1"/>
                                    <path d="m19.1 15.2.3-.9"/>
                                    <path d="m19.6 21.7-.4-1"/>
                                    <path d="m20.7 16.8 1-.4"/>
                                    <path d="m21.7 19.4-.9-.3"/>
                                    <path d="M9 3v18"/>
                                    <circle cx="18" cy="18" r="3"/>
                                </svg>
                                <span class="hidden md:block">Columns</span>
                            </Button>
                        </Slot>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent>
                        @foreach (var column in columnsWithTitle)
                        {
                            <DropdownMenuCheckboxItem DefaultValue="@column.IsVisible"
                                                      ValueChanged="b => SetColumnVisibleAsync(column, b)"
                                                      @key="column">
                                @column.Title
                            </DropdownMenuCheckboxItem>
                        }
                    </DropdownMenuContent>
                </DropdownMenu>
            }
        </div>
    </div>

    <div class="@Classes">
        <Table @attributes="Props">
            <TableHeader>
                <TableRow>
                    @HeaderFragment
                </TableRow>
            </TableHeader>
            <TableBody>
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="99999">
                            <div class="w-full flex items-center justify-center p-5">
                                <Spinner ClassName="size-10"/>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    if (Items.Length == 0)
                    {
                        <tr>
                            <td colspan="99999">
                                <div class="w-full flex items-center justify-center p-5">
                                    <Empty>
                                        <EmptyHeader>
                                            <EmptyMedia Variant="EmptyMediaVariant.Icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                     class="lucide lucide-search-icon lucide-search">
                                                    <path d="m21 21-4.34-4.34"/>
                                                    <circle cx="11" cy="11" r="8"/>
                                                </svg>
                                            </EmptyMedia>
                                            <EmptyTitle>No items found</EmptyTitle>
                                            <EmptyDescription>
                                                No items have been found for your request
                                            </EmptyDescription>
                                        </EmptyHeader>
                                    </Empty>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @RowFragment

                        foreach (var item in Items)
                        {
                            <TableRow @key="item">
                                @CellFragment.Invoke(item)
                            </TableRow>
                        }
                    }
                }
            </TableBody>
        </Table>
    </div>

    <div class="flex items-center justify-end md:justify-between mt-1.5">
        <div class="hidden md:block text-muted-foreground">
            Showing @(StartIndex + 1)-@(StartIndex + Items.Length) of @(TotalItems) items
        </div>
        <div class="flex items-center gap-x-1">
            <Button disabled="@(IsLoading || CurrentPage == 0)"
                    @onclick="NavigateToStartAsync"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.IconSm">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-chevrons-left-icon lucide-chevrons-left">
                    <path d="m11 17-5-5 5-5"/>
                    <path d="m18 17-5-5 5-5"/>
                </svg>
            </Button>

            <Button disabled="@(IsLoading || CurrentPage == 0)"
                    @onclick="() => NavigateAsync(-1)"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-chevron-left-icon lucide-chevron-left">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
                <span class="hidden md:block">Previous</span>
            </Button>

            <Button disabled="@(IsLoading || CurrentPage == MaximumPage)"
                    @onclick="() => NavigateAsync(1)"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm">
                <span class="hidden md:block">Next</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-chevron-right-icon lucide-chevron-right">
                    <path d="m9 18 6-6-6-6"/>
                </svg>
            </Button>
            <Button disabled="@(IsLoading || CurrentPage == MaximumPage)"
                    @onclick="NavigateToEndAsync"
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.IconSm">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-chevrons-right-icon lucide-chevrons-right">
                    <path d="m6 17 5-5-5-5"/>
                    <path d="m13 17 5-5-5-5"/>
                </svg>
            </Button>
        </div>
    </div>
}

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "overflow-hidden rounded-md border",
            ClassName
        );
    }
}