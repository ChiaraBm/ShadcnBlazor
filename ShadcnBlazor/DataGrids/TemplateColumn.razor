@using Microsoft.AspNetCore.Components.Rendering
@using ShadcnBlazor.DataGrids.Abstractions

@typeparam TGridItem
@inherits ColumnBase<TGridItem>

@code
{
    [Parameter] public RenderFragment? HeadTemplate { get; set; }
    [Parameter] public required RenderFragment<TGridItem> CellTemplate { get; set; }

    public override void RenderHead(RenderTreeBuilder __builder)
    {
        if (HeadTemplate != null)
            HeadTemplate.Invoke(__builder);
        else
            base.RenderHead(__builder);
    }

    public override void RenderCell(RenderTreeBuilder __builder, TGridItem item)
    {
        CellTemplate.Invoke(item).Invoke(__builder);
    }
}
