@using LucideBlazor
@using ShadcnBlazor.Buttons
@inherits ShadcnBase

<PaginationLink aria-label="@Translations.Paginations_PreviousAriaLabel"
                Size="Size"
                ClassName="@Classes"
                @attributes="Props">

    <ChevronLeftIcon />
    <span class="hidden sm:block">@Translations.Paginations_Previous</span>
</PaginationLink>

@code
{
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Default;
    
    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn("gap-1 px-2.5 sm:pl-2.5", ClassName);
    }
}