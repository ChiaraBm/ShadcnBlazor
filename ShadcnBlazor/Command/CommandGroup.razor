@inherits ShadcnBase

<div
    cmdk-group
    data-slot="command-group"
    class="@Classes"
    aria-hidden="@((!IsVisible).ToString().ToLowerInvariant())"
    hidden="@(!IsVisible)"
    @attributes="Props">
    
    @if (Heading != null)
    {
        <div cmdk-group-heading>
            @Heading
        </div>
    }
    
    <div cmdk-group-items>
        <CascadingValue
            TValue="CommandGroup"
            Value="this">
            @ChildContent
        </CascadingValue>
    </div>
    
</div>

@code
{
    [CascadingParameter] public Command Command { get; set; }
    
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string? Heading { get; set; }

    public bool IsVisible { get; private set; } = true;
    
    private readonly List<CommandItem> Items = new();

    private string? Classes;

    protected override void OnInitialized()
    {
        Command.RegisterGroup(this);
    }

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "text-foreground [&_[cmdk-group-heading]]:text-muted-foreground overflow-hidden p-1 [&_[cmdk-group-heading]]:px-2 [&_[cmdk-group-heading]]:py-1.5 [&_[cmdk-group-heading]]:text-xs [&_[cmdk-group-heading]]:font-medium",
            ClassName
        );
    }
    
    internal void HandleSearch(string _)
    {
        IsVisible = Items.Any(x => x.IsVisible);
    }

    internal void RegisterItem(CommandItem item) => Items.Add(item);
}