@inherits ShadcnBase

<div
    data-slot="command-group"
    @attributes="Props"
    class="@Classes"
    aria-hidden="@Hidden"
    hidden="@Hidden"
>
    @if (Heading != null)
    {
        <div>
            @Heading
        </div>
    }
    <CascadingValue
        TValue="CommandGroup"
        Value="this"
    >
        @ChildContent
    </CascadingValue>
</div>

@code {
    [CascadingParameter] public Command Command { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string? Heading { get; set; }


    internal List<CommandItem> IncludedItems { get; set; } = [];
    private CommandItem FocusedItem { get; set; }
    private string? Classes;
    private bool Hidden = false;

    protected override void OnInitialized()
    {
        Command.CommandGroups.Add(this);
    }

    protected override void OnParametersSet()
    {
        Classes = Cn("text-foreground text-muted-foreground overflow-hidden p-1 px-2 py-1.5 text-xs font-medium", ClassName);
    }

    public void ApplyVisibility()
    {
        Hidden = IncludedItems.Count <= 1 || Command.FilteredItems.Length == 0;
    }

    public async Task OnFocusUpdateAsync(CommandItem item)
    {
        if (FocusedItem != null && FocusedItem != item)
            await FocusedItem.OnUnfocusAsync();

        FocusedItem = item;
    }


}