@inherits ShadcnBase

<div
    data-slot="command-group"
    @attributes="Props"
    class="@Classes"
    aria-hidden="@Hidden"
    hidden="@Hidden"
>
    @if (Heading != null)
    {
        <div>
            @Heading
        </div>
    }
    <CascadingValue
        TValue="CommandGroup"
        Value="this"
    >
        @ChildContent
    </CascadingValue>
</div>

@code {
    [CascadingParameter] public Command Command { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string? Heading { get; set; }


    public List<CommandItem> CommandItems { get; set; } = [];
    private string? Classes;
    public bool Hidden;

    protected override void OnParametersSet()
    {
        Classes = Cn("text-foreground text-muted-foreground overflow-hidden p-1 px-2 py-1.5 text-xs font-medium", ClassName);
    }

    public void OnHide(bool expr)
    {
        Hidden = expr;
    }

}