@inherits ShadcnBase

<div @attributes="Attributes" class="@Classes">
    <CascadingValue TValue="Command" Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code
{
    
    // TODO: CommandGroup Filtering
    // TODO: CommandItem Selection via mouseover...
    
    [Parameter] public RenderFragment ChildContent { get; set; }

    public List<string> Items { get; set; } = [];
    public string[] FilteredItems { get; set; } = [];

    internal CommandEmpty EmptyCommand { get; set; }
    internal CommandSeparator CommandSeparator { get; set; }
    internal List<CommandGroup> CommandGroups { get; set; } = [];
    internal List<CommandItem> CommandItems { get; set; } = [];

    private string? Classes;
    private Dictionary<string, object?> Attributes;

    protected override void OnParametersSet()
    {
        Attributes = new();

        Attributes["data-slot"] = "command";

        Classes = Cn(
            "bg-popover text-popover-foreground flex h-full w-full flex-col overflow-hidden rounded-md",
            ClassName
        );

        if (Props == null)
            return;

        foreach (var prop in Props)
            Attributes[prop.Key] = prop.Value;
    }

    public async Task UpdateFilteredItems(ChangeEventArgs eventArgs)
    {
        var search = eventArgs.Value?.ToString() ?? "";

        if (string.IsNullOrEmpty(search) || Items.Count < 1)
        {
            FilteredItems = Items.ToArray();
        }
        else
        {
            FilteredItems = Items.Where(s => s.Contains(search, StringComparison.OrdinalIgnoreCase)).ToArray();
        }

        foreach (var commandItem in CommandItems)
        {
            commandItem.ApplyVisibility();
        }

        foreach (var commandGroup in CommandGroups)
        {
            commandGroup.ApplyVisibility();
        }

        EmptyCommand.ApplyVisibility();
        CommandSeparator.ApplyVisibility();
        await InvokeAsync(StateHasChanged);
    }

}
