@inherits ShadcnBase

<div
    data-slot="command-item"
    @attributes="Props"
    class="@Classes"
    aria-disabled="@Disabled"
    data-disabled="@Disabled"
    aria-hidden="@Hidden"
    hidden="@Hidden"
    onmouseenter="this.focus()"
    @onfocus="OnFocusAsync"
>
    @ChildContent
</div>

@code {
    [CascadingParameter] public Command Command { get; set; }
    [CascadingParameter] public CommandGroup CommandGroup { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public required string Name { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? Classes;
    private bool Hidden { get; set; }

    protected override void OnInitialized()
    {
        Command.CommandItems.Add(this);
        Command.Items.Add(Name);
        CommandGroup.IncludedItems.Add(this);
    }

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "focus:bg-accent focus:text-accent-foreground [&_svg:not([class*='text-'])]:text-muted-foreground relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
            ClassName
        );
    }

    public void ApplyVisibility()
    {
        Hidden = !Command.FilteredItems.Contains(Name);

        if (!Command.FilteredItems.Contains(Name))
        {
            CommandGroup.IncludedItems.Remove(this);
        }
        else
        {
            CommandGroup.IncludedItems.Add(this);
        }

        CommandGroup.ApplyVisibility();
    }

    private async Task OnFocusAsync()
    {
        if (Disabled) return;

        await CommandGroup.OnFocusUpdateAsync(this);
    }

    public Task OnUnfocusAsync()
    {
        return Task.CompletedTask;
    }

}