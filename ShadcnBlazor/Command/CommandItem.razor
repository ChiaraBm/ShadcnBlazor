@inherits ShadcnBase

<div
    data-slot="command-item"
    @attributes="Props"
    class="@Classes"
    aria-disabled="@Disabled"
    data-disabled="@Disabled"
    aria-hidden="@Hidden"
    hidden="@Hidden"
>
    @ChildContent
</div>

@code {

    // TODO: Add selection from Items
    //  data-selected={Boolean(selected)}
    //  aria-selected={Boolean(selected)}

    [CascadingParameter] public Command Command { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public required string Name { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? Classes;
    private bool Hidden = false;

    protected override void OnParametersSet()
    {
        Command.CommandItems.Add(this);

        Command.Items.Add(Name);
        Command.FilteredItems.Add(Name);

        Classes = Cn(
            "data-[selected=true]:bg-accent data-[selected=true]:text-accent-foreground [&_svg:not([class*='text-'])]:text-muted-foreground relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
            ClassName
        );
    }

    public void ApplyVisibility()
    {
        Hidden = !Command.FilteredItems.Contains(Name);
    }

}