@inherits ShadcnBase

<CascadingValue TValue="MenubarRadioGroup" Value="this">
    @ChildContent
</CascadingValue>

@code
{
    [CascadingParameter] public IMenubarParent Parent { get; set; }
    
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public bool CloseOnClick { get; set; } = true;
    
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? DefaultValue { get; set; }
    
    protected override void OnInitialized()
    {
        if (DefaultValue != null)
            Value = DefaultValue;
    }

    internal async Task ChangeValueAsync(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        await InvokeAsync(StateHasChanged);

        Console.WriteLine("A: " + Value);
        
        if (CloseOnClick)
            await Parent.CloseMenuAsync();
    }
}