@inherits ShadcnBase

<div
    cmdk-separator
    data-slot="command-separator"
    class="@Classes"
    hidden="@Command.IsSearching"
    @attributes="Props">
</div>

@code
{
    [CascadingParameter] public Command Command { get; set; }

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "bg-border -mx-1 h-px",
            ClassName
        );
    }
}