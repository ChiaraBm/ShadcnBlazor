@inherits ShadcnBase


<div cmdk-item
     data-slot="command-item"
     data-disabled="@Disabled.ToString().ToLowerInvariant()"
     aria-disabled="@Disabled.ToString().ToLowerInvariant()"
     aria-hidden="@((!IsVisible).ToString().ToLowerInvariant())"
     hidden="@(!IsVisible)"
     data-selected="@Selected.ToString().ToLowerInvariant()"
     @onmouseenter="OnMouseEnterAsync"
     @onmouseleave="OnMouseLeaveAsync"
     @onclick="OnClickedAsync"
     class="@Classes"
     @attributes="Props">
    
    @ChildContent
    
</div>


@code
{
    [CascadingParameter] public Command Command { get; set; }
    [CascadingParameter] public CommandGroup CommandGroup { get; set; }
    
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public required string Name { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClicked { get; set; }

    public bool IsVisible { get; private set; } = true;

    private string? Classes;
    private bool Selected;

    protected override void OnInitialized()
    {
        Command.RegisterItem(this);
        CommandGroup.RegisterItem(this);
    }

    internal void HandleSearch(string searchTerm)
    {
        IsVisible = string.IsNullOrWhiteSpace(searchTerm) || Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "data-[selected=true]:bg-accent data-[selected=true]:text-accent-foreground [&_svg:not([class*='text-'])]:text-muted-foreground relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
            ClassName
        );
    }

    private async Task OnMouseEnterAsync()
    {
        Selected = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnMouseLeaveAsync()
    {
        Selected = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnClickedAsync()
    {
        await OnClicked.InvokeAsync();
        await Command.HandleItemClickedAsync(this);
    }
}