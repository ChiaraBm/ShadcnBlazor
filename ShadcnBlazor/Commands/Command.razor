@inherits ShadcnBase

<div cmdk-root data-slot="command" class="@Classes" @attributes="Props">
    <CascadingValue TValue="Command" Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public EventCallback<CommandItem> OnItemClicked { get; set; }

    public bool IsSearching { get; private set; }
    public bool IsEmpty { get; private set; }
    
    private readonly List<CommandItem> Items = new();
    private readonly List<CommandGroup> Groups = new();

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "bg-popover text-popover-foreground flex h-full w-full flex-col overflow-hidden rounded-md",
            ClassName
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)
            return;

        await UpdateAsync(string.Empty);
    }

    public async Task UpdateFilteredItemsAsync(ChangeEventArgs eventArgs)
        => await UpdateAsync(eventArgs.Value?.ToString() ?? "");

    private async Task UpdateAsync(string searchTerm)
    {
        IsSearching = !string.IsNullOrWhiteSpace(searchTerm);

        foreach (var item in Items)
            item.HandleSearch(searchTerm);

        foreach (var group in Groups)
            group.HandleSearch(searchTerm);

        IsEmpty = Items.All(x => !x.IsVisible);

        await InvokeAsync(StateHasChanged);
    }

    internal async Task HandleItemClickedAsync(CommandItem item)
        => await OnItemClicked.InvokeAsync(item);

    internal void RegisterItem(CommandItem item) => Items.Add(item);
    internal void RegisterGroup(CommandGroup group) => Groups.Add(group);
}