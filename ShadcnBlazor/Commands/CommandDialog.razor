@inherits ShadcnBase
@using ShadcnBlazor.Dialogs

<Dialog @ref="Dialog" OnOpenChange="OnOpenChange" DefaultOpen="DefaultOpen" @attributes="@Props">
    <DialogHeader ClassName="sr-only">
        <DialogTitle>@Title</DialogTitle>
        <DialogDescription>@Description</DialogDescription>
    </DialogHeader>
    <DialogContent CloseOnBackdropClick="true"
                   ClassName="@Classes"
                   ShowCloseButton="ShowCloseButton">
        <Command OnItemClicked="Dialog.CloseAsync"
                 ClassName="[&_[cmdk-group-heading]]:text-muted-foreground **:data-[slot=command-input-wrapper]:h-12 [&_[cmdk-group-heading]]:px-2 [&_[cmdk-group-heading]]:font-medium [&_[cmdk-group]]:px-2 [&_[cmdk-group]:not([hidden])_~[cmdk-group]]:pt-0 [&_[cmdk-input-wrapper]_svg]:h-5 [&_[cmdk-input-wrapper]_svg]:w-5 [&_[cmdk-input]]:h-12 [&_[cmdk-item]]:px-2 [&_[cmdk-item]]:py-3 [&_[cmdk-item]_svg]:h-5 [&_[cmdk-item]_svg]:w-5">
            @ChildContent
        </Command>
    </DialogContent>
</Dialog>

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }
    
    [Parameter] public string Title { get; set; } = "Command Palette";
    [Parameter] public string Description { get; set; } = "Search for a command to run...";
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    [Parameter] public EventCallback<bool> OnOpenChange { get; set; }
    [Parameter] public bool DefaultOpen { get; set; }

    public bool IsOpen => Dialog.IsOpen;

    private Dialog Dialog;
    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn("p-0 overflow-hidden", ClassName);
    }
}