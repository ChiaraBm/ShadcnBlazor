@using ShadcnBlazor.Popovers
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Calendars
@using ShadcnBlazor.Interop

@inherits ShadcnBase

<Popover @ref="Popover">
    <PopoverTrigger>
        <Slot>
            <Button
                Variant="ButtonVariant.Outline"
                id="date"
                ClassName="@Classes"
                @attributes="@(Props == null ? context : context.Concat(Props))">
                
                @if (_value == default)
                {
                    <span>Select date</span>
                }
                else
                {
                    @_value.ToShortDateString();
                }
                
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
            </Button>
        </Slot>
    </PopoverTrigger>
    <PopoverContent ClassName="w-auto overflow-hidden p-0" Align="PositionAlignment.Start">
        <Calendar StartDate="StartDate" ViewStart="ViewStart" ViewEnd="ViewEnd" Entries="Entries" OnClick="OnDateSelectedAsync" />
    </PopoverContent>
</Popover>

@code
{
    [Parameter] public DateOnly? StartDate { get; set; }
    [Parameter] public DateOnly ViewStart { get; set; }
    [Parameter] public DateOnly ViewEnd { get; set; }

    private CalendarEntry[] Entries;
    
    [Parameter]
    public DateOnly Value
    {
        get => _value;
        set
        {
            if (_value == value) return;

            _value = value;
            ValueChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<DateOnly> ValueChanged { get; set; }

    private DateOnly _value;
    private Popover Popover;
    private string? Classes;

    protected override void OnInitialized()
    {
        if (_value == default)
        {
            Entries = [];
            return;
        }

        Entries = [new CalendarEntry(_value, _value, true)];
    }

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "w-48 justify-between font-normal",
            ClassName
        );
    }

    private async Task OnDateSelectedAsync(DateOnly value)
    {
        Entries = [new CalendarEntry(value, value, true)];
        StartDate = value;
        Value = value;

        await Popover.CloseAsync();
        await InvokeAsync(StateHasChanged);
    }
}
