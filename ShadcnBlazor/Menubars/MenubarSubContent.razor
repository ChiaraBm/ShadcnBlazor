@using ShadcnBlazor.Interop

@inherits ShadcnBase

@inject PositionService PositionService

@if (Sub.ShouldRenderContent)
{
    <div @ref="PositionElement" class="min-w-max z-50 fixed top-0 left-0" style="@PositionStyle">
        <div  data-slot="menubar-sub-content"
              class="@Classes"
              data-state="@(Sub.IsOpen ? "open" : "closed")"
              @attributes="Props">
            @ChildContent
        </div>
    </div>
}

@code
{
    [CascadingParameter] public Menubar Menubar { get; set; }
    [CascadingParameter] public MenubarSub Sub { get; set; }
    
    [Parameter] public RenderFragment ChildContent { get; set; }
    
    private string? Classes;

    private ElementReference PositionElement;
    private string PositionStyle = PositionService.Position.OffCanvasCss;
    private bool IsPositioned;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "bg-popover text-popover-foreground data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 z-50 min-w-[8rem] origin-(--radix-menubar-content-transform-origin) overflow-hidden rounded-md border p-1 shadow-lg",
            ClassName
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Sub.ShouldRenderContent && !IsPositioned)
        {
            var position = await PositionService.PositionAroundAsync(
                Sub.Trigger.TriggerElement,
                PositionElement,
                PositionSide.Right
            );

            PositionStyle = position.ToCssStyle();
            IsPositioned = true;

            await InvokeAsync(StateHasChanged);
        }
        else
            IsPositioned = false;
    }
}
