@using System.Globalization
@using System.Text

@inherits ShadcnBase

@inject InteropService InteropService

@if (!IsHidden)
{
    <div
        @ref="TrackElement"
        @attributes="Props"
        data-slot="scroll-area-scrollbar"
        data-orientation="@Orientation.ToString().ToLower()"
        data-state="@(IsHidden ? "hidden" : "visible")"
        data-horizontal="@(Orientation == ScrollBarOrientation.Horizontal)"
        data-vertical="@(Orientation == ScrollBarOrientation.Vertical)"
        class="@Classes"
        style="@BuildStyle()"
    >
        <div
            @ref="ThumbElement"
            data-slot="scroll-area-thumb"
            data-state="@(IsHidden ? "hidden" : "visible")"
            class="relative flex-1 rounded-full bg-border"
            style="@BuildThumbStyle()"
        >
        </div>
    </div>
}

@code
{
    [CascadingParameter, EditorRequired] public ScrollArea ScrollArea { get; set; }
    [Parameter] public ScrollBarOrientation Orientation { get; set; } = ScrollBarOrientation.Vertical;

    internal double TransformTx = 0;
    internal double TransformTy = 0;

    private bool IsHidden = true;
    private bool IsInitialized = true;
    private string? Classes;

    private ElementReference? TrackElement;
    private ElementReference? ThumbElement;

    private ScrollBarStyle ScrollBarStyle = new();
    private ScrollBarThumbStyles ScrollBarThumbStyle = new();

    protected override void OnParametersSet()
    {
        ScrollArea.ScrollBar ??= this;

        Classes = Cn(
            "absolute flex touch-none p-px transition-colors select-none data-horizontal:w-[calc(100%-10px)] data-horizontal:border-l-transparent data-horizontal:h-2.5 data-horizontal:flex-col data-horizontal:border-t data-horizontal:border-t-transparent data-vertical:h-full data-vertical:w-2.5 data-vertical:border-l data-vertical:border-l-transparent",
            ClassName
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsInitialized && !IsHidden && TrackElement.HasValue && ThumbElement.HasValue)
        {
            IsInitialized = true;
            
            await InteropService.AttachAsync(
                ScrollArea.ScrollAreaElement, TrackElement.Value, ThumbElement.Value, Orientation
            );
        }
        else if (IsHidden && IsInitialized)
            IsInitialized = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ScrollArea.Type == ScrollAreaType.Always)
            await HideAsync(false);

        if (ScrollArea.Type == ScrollAreaType.Auto)
        {
            var isContentOverflowing = await InteropService.IsContentOverflowingAsync(
                ScrollArea.ScrollAreaElement, Orientation
            );
            if (isContentOverflowing)
                await HideAsync(false);
        }

        var scrollBarThumbSize = await InteropService.GetScrollBarThumbSizeAsync(ScrollArea.ScrollAreaElement);
        
        switch (ScrollArea.Direction)
        {
            case ScrollAreaDirection.Ltr:
                if (Orientation == ScrollBarOrientation.Vertical)
                    ScrollBarStyle.Right = 0;
                else
                    ScrollBarStyle.Left = 0;
                break;
            case ScrollAreaDirection.Rtl:
                if (Orientation == ScrollBarOrientation.Vertical)
                    ScrollBarStyle.Left = 0;
                else
                    ScrollBarStyle.Right = 0;
                break;
        }

        switch (Orientation)
        {
            case ScrollBarOrientation.Vertical:
                ScrollBarThumbStyle.Height = scrollBarThumbSize.ScrollBarVerticalSize;
                ScrollBarStyle.Top = 0;
                ScrollBarStyle.Bottom = 10;
                break;
            case ScrollBarOrientation.Horizontal:
                ScrollBarThumbStyle.Width = scrollBarThumbSize.ScrollBarHorizontalSize;
                ScrollBarStyle.Bottom = 0;
                ScrollBarStyle.Left = 10;
                ScrollBarStyle.Right = 10;
                break;
        }
    }

    private string BuildStyle()
    {
        var sb = new StringBuilder();

        sb.Append("touch-action: none;");
        sb.Append("user-select: none;");

        if (ScrollBarStyle.Top != null)
            sb.Append($"top: {ScrollBarStyle.Top.Value.ToString(CultureInfo.InvariantCulture)}px;");
        if (ScrollBarStyle.Left != null)
            sb.Append($"left: {ScrollBarStyle.Left.Value.ToString(CultureInfo.InvariantCulture)}px;");
        if (ScrollBarStyle.Right != null)
            sb.Append($"right: {ScrollBarStyle.Right.Value.ToString(CultureInfo.InvariantCulture)}px;");
        if (ScrollBarStyle.Bottom != null)
            sb.Append($"bottom: {ScrollBarStyle.Bottom.Value.ToString(CultureInfo.InvariantCulture)}px;");

        return sb.ToString();
    }

    private string BuildThumbStyle()
    {
        var sb = new StringBuilder();

        sb.Append("touch-action: none;");
        sb.Append("user-select: none;");
        sb.Append($"transform: translate3d({TransformTx.ToString(CultureInfo.InvariantCulture)}px, {TransformTy.ToString(CultureInfo.InvariantCulture)}px, 0px);");

        if (ScrollBarThumbStyle.Width != null)
            sb.Append($"width: {ScrollBarThumbStyle.Width.Value.ToString(CultureInfo.InvariantCulture)}px;");

        if (ScrollBarThumbStyle.Height != null)
            sb.Append($"height: {ScrollBarThumbStyle.Height.Value.ToString(CultureInfo.InvariantCulture)}px;");

        return sb.ToString();
    }

    internal async Task RefreshAsync() => await InvokeAsync(StateHasChanged);

    internal async Task HideAsync(bool hide)
    {
        IsHidden = hide;
        await RefreshAsync();
    }
}
