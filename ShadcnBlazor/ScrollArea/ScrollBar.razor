@inherits ShadcnBase

<div
    data-slot="scroll-area-scrollbar"
    data-orientation="@Orientation.ToString().ToLower()"
    orientation="@Orientation.ToString().ToLower()"
    @attributes="Props"
    class="@Classes"
>
    <div data-slot="scroll-area-thumb"
         class="relative flex-1 rounded-full bg-border">
    </div>
</div>

@code
{
    [Parameter] public ScrollBarOrientation Orientation { get; set; } = ScrollBarOrientation.Vertical;
    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn("flex touch-none p-px transition-colors select-none data-horizontal:h-2.5 data-horizontal:flex-col data-horizontal:border-t data-horizontal:border-t-transparent data-vertical:h-full data-vertical:w-2.5 data-vertical:border-l data-vertical:border-l-transparent", ClassName);
    }

}
