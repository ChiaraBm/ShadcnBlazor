@using LucideBlazor
@inherits ShadcnBase

<button data-slot="radio-group-item"
        class="@Classes"
        disabled="@(RadioGroup.Disabled || Disabled)"
        data-disabled="@(RadioGroup.Disabled || Disabled)"
        data-state="@(IsChecked ? "checked" : "unchecked")"
        @onclick="OnClickAsync"
        type="button"
        @attributes="Props">
    
    @if (IsChecked)
    {
        <span data-slot="radio-group-indicator"
              class="relative flex items-center justify-center">
            <CircleIcon ClassName="fill-primary absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2" />
        </span>
    }
</button>

@code
{
    [CascadingParameter] public RadioGroup RadioGroup { get; set; }
    
    [Parameter] public string Value { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool IsChecked => Value == RadioGroup.Value;
    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "border-input text-primary focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:bg-input/30 aspect-square size-4 shrink-0 rounded-full border shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50",
            ClassName
        );
    }

    private Task OnClickAsync()
    {
        if (Disabled)
            return Task.CompletedTask;
        
        return RadioGroup.SetValueAsync(Value);
    }
}
