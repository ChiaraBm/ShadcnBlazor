@inherits ShadcnBase

<div data-slot="radio-group"
     data-disabled="@Disabled"
     class="@Classes">
    @* 
    Setting the value fixed wount update all child components render tree when value has been changed.
    Normally we trigger the update from within the component or the child components are also just razor components
    and not html components cause in taht case a fixed value just works
    *@
    <CascadingValue TValue="RadioGroup" IsFixed="false" Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string DefaultValue { get; set; }

    [Parameter]
    public string Value
    {
        get => _value;
        set
        {
            if (_value == value) return;

            _value = value;
            ValueChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private string _value;
    
    private string? Classes;

    protected override void OnInitialized()
    {
        _value = DefaultValue;
    }

    protected override void OnParametersSet()
    {
        Classes = Cn("grid gap-3", ClassName);
    }

    public async Task SetValueAsync(string value)
    {
        Value = value;
        await InvokeAsync(StateHasChanged);
    }
}
