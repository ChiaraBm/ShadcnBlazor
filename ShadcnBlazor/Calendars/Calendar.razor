@using System.Globalization
<div
    class="w-fit bg-background group/calendar p-3 [--cell-size:--spacing(8)] [[data-slot=card-content]_&]:bg-transparent [[data-slot=popover-content]_&]:bg-transparent rtl:**:[.rdp-button\_next>svg]:rotate-180 rtl:**:[.rdp-button\_previous>svg]:rotate-180 rounded-md border shadow-sm">
    <div class="flex gap-4 flex-col md:flex-row relative">
        <nav class="flex items-center gap-1 w-full absolute top-0 inset-x-0 justify-between">
            <button
                @onclick="() => NavigateAsync(-1)"
                disabled="@(Current.AddMonths(-1) < ViewStart)"
                class="hover:cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 has-[>svg]:px-3 size-(--cell-size) aria-disabled:opacity-50 p-0 select-none"
                type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-chevron-left-icon lucide-chevron-left">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </button>

            <button
                @onclick="() => NavigateAsync(1)"
                disabled="@(Current.AddMonths(1) > ViewEnd)"
                class="hover:cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 has-[>svg]:px-3 size-(--cell-size) aria-disabled:opacity-50 p-0 select-none"
                type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-chevron-right-icon lucide-chevron-right">
                    <path d="m9 18 6-6-6-6"/>
                </svg>
            </button>
        </nav>
        <div class="flex flex-col w-full gap-4">
            <div class="flex items-center justify-center w-full">
                <div class="w-full flex items-center text-sm font-medium justify-center gap-1.5">
                    <span data-disabled="false"
                          class="relative has-focus:border-ring border border-input shadow-xs has-focus:ring-ring/50 has-focus:ring-[3px] rounded-md rdp-dropdown_root">
                        <select class="absolute bg-popover inset-0 opacity-0"
                                aria-label="Choose the Month"
                                @onchange="OnMonthInput">
                            @foreach (var month in Months)
                            {
                                <option value="@month.Key" selected="@(month.Key == Current.Month)">
                                    @month.Value
                                </option>
                            }
                        </select>
                        <span
                            class="select-none font-medium rounded-md pl-2 pr-1 flex items-center gap-1 text-sm h-8 [&amp;&gt;svg]:text-muted-foreground [&amp;&gt;svg]:size-3.5 rdp-caption_label"
                            aria-hidden="true">
                            
                            @CultureInfo.CurrentUICulture.DateTimeFormat.GetAbbreviatedMonthName(Current.Month)

                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="lucide lucide-chevron-down size-4 rdp-chevron">
                                <path
                                    d="m6 9 6 6 6-6"></path></svg>
                        </span>
                    </span>
                    <span data-disabled="false"
                          class="relative has-focus:border-ring border border-input shadow-xs has-focus:ring-ring/50 has-focus:ring-[3px] rounded-md rdp-dropdown_root">
                        <select @onchange="OnYearInput"
                            class="absolute bg-popover inset-0 opacity-0 rdp-dropdown rdp-years_dropdown"
                            aria-label="Choose the Year">
                            @foreach (var year in Years)
                            {
                                <option value="@year" selected="@(year == Current.Year)">@year</option>
                            }
                        </select>
                        <span
                            class="select-none font-medium rounded-md pl-2 pr-1 flex items-center gap-1 text-sm h-8 [&amp;&gt;svg]:text-muted-foreground [&amp;&gt;svg]:size-3.5 rdp-caption_label"
                            aria-hidden="true">
                            
                            @Current.Year

                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="lucide lucide-chevron-down size-4 rdp-chevron">
                                <path
                                    d="m6 9 6 6 6-6"></path></svg>
                        </span>
                    </span>
                </div>
            </div>
            <table role="grid">
                <thead aria-hidden="true">
                <tr class="flex">
                    @foreach (var weekDays in WeekDays)
                    {
                        <th aria-label="@weekDays.Key"
                            class="text-muted-foreground rounded-md flex-1 font-normal text-[0.8rem] select-none"
                            scope="col">
                            @weekDays.Value
                        </th>
                    }
                </tr>
                </thead>
                <tbody>

                @for (var week = 0; week < 5; week++)
                {
                    <tr class="flex w-full mt-2">

                        @for (var day = 0; day < 7; day++)
                        {
                            var date = CurrentStart.AddDays(week * 7 + day);

                            var classes = date.Month == Current.Month ? "" : "text-muted-foreground aria-selected:text-muted-foreground";

                            var isSingle = false;
                            var isStart = false;
                            var isEnd = false;
                            var isMiddle = false;

                            foreach (var entry in FilteredEntries)
                            {
                                if (entry.StartDate == date)
                                {
                                    if (entry.IsSingle)
                                    {
                                        isSingle = true;
                                        break;
                                    }

                                    isStart = true;
                                    break;
                                }

                                if (date > entry.StartDate && date < entry.EndDate)
                                {
                                    isMiddle = true;
                                    break;
                                }

                                if (entry.EndDate == date)
                                {
                                    isEnd = true;
                                    break;
                                }
                            }

                            var btnClasses = "";

                            if (isSingle)
                                btnClasses = "rounded-md";
                            else
                            {
                                if (!isMiddle)
                                {
                                    if (isStart)
                                        btnClasses = "rounded-l-md";
                                    else if (isEnd)
                                        btnClasses = "rounded-r-md";
                                    else
                                        btnClasses = "rounded-md";
                                }
                            }

                            <td class="relative w-full h-full p-0 text-center group/day aspect-square select-none @classes"
                                role="gridcell" data-day="2025-10-26" data-month="2025-10" data-outside="true">
                                <button data-slot="button"
                                        disabled="@(date < ViewStart || date > ViewEnd)"
                                        class="hover:cursor-pointer items-center justify-center whitespace-nowrap text-sm disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 data-[selected-single=true]:bg-primary data-[selected-single=true]:text-primary-foreground data-[range-middle=true]:bg-accent data-[range-middle=true]:text-accent-foreground data-[range-start=true]:bg-primary data-[range-start=true]:text-primary-foreground data-[range-end=true]:bg-primary data-[range-end=true]:text-primary-foreground group-data-[focused=true]/day:border-ring group-data-[focused=true]/day:ring-ring/50 dark:hover:text-accent-foreground flex aspect-square size-auto w-full min-w-(--cell-size) flex-col gap-1 leading-none font-normal group-data-[focused=true]/day:relative group-data-[focused=true]/day:z-10 group-data-[focused=true]/day:ring-[3px] @(btnClasses) [&amp;&gt;span]:text-xs [&amp;&gt;span]:opacity-70"
                                        data-day="10/26/2025" type="button" tabindex="-1"
                                        aria-label="@date.ToString()"
                                        data-selected-single="@isSingle.ToString().ToLower()"
                                        data-range-start="@isStart.ToString().ToLower()"
                                        data-range-middle="@(isMiddle.ToString().ToLower())"
                                        data-range-end="@(isEnd.ToString().ToLower())"
                                        @onclick="() => OnClick.InvokeAsync(date)">
                                    @date.Day
                                </button>
                            </td>
                        }
                    </tr>
                }

                </tbody>
            </table>
        </div>
    </div>
</div>

@code
{
    [Parameter] public DateOnly? StartDate { get; set; }
    [Parameter] public EventCallback<DateOnly> OnClick { get; set; }
    
    [Parameter] public DateOnly ViewStart { get; set; }
    [Parameter] public DateOnly ViewEnd { get; set; }

    [Parameter]
    public IEnumerable<CalendarEntry> Entries { get; set; }
    
    private CalendarEntry[] FilteredEntries;

    private DateOnly Current;
    private DateOnly CurrentStart;
    
    private readonly List<int> Years = new();
    private readonly Dictionary<int, string> Months = new();
    private readonly Dictionary<DayOfWeek, string> WeekDays = new();
    
    private readonly DateOnly Now = DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        Current = StartDate.HasValue
            ? new DateOnly(StartDate.Value.Year, StartDate.Value.Month, 1)
            : new DateOnly(Now.Year, Now.Month, 1);

        for (var i = ViewStart.Year; i <= ViewEnd.Year; i++)
            Years.Add(i);

        int start, end;
        
        if (ViewEnd.Year > ViewStart.Year)
        {
            start = 1;
            end = 12;
        }
        else
        {
            start = ViewStart.Month;
            end = ViewEnd.Month;
        }
        
        for (var i = start; i <= end; i++)
        {
            var name = CultureInfo
                .CurrentUICulture
                .DateTimeFormat
                .GetAbbreviatedMonthName(i);

            Months.Add(i, name);
        }

        foreach (var dayOfWeek in Enum.GetValues<DayOfWeek>())
            WeekDays.Add(dayOfWeek, CultureInfo.CurrentUICulture.DateTimeFormat.GetAbbreviatedDayName(dayOfWeek));

        await RefreshAsync();
    }

    public async Task SetCurrentDateAsync(DateOnly date)
    {
        Current = date;
        
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async Task NavigateAsync(int month)
    {
        Current = Current.AddMonths(month);

        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    public Task RefreshAsync()
    {
        var selectionStartDate = new DateOnly(Current.Year, Current.Month, 1);
        CurrentStart = selectionStartDate.AddDays(-(int)selectionStartDate.DayOfWeek);
        var currentEnd = CurrentStart.AddDays(5 * 7);

        FilteredEntries = Entries.Where(x => x.StartDate >= CurrentStart || x.EndDate <= currentEnd || (x.StartDate < CurrentStart && x.EndDate > currentEnd))
            .ToArray();

        return Task.CompletedTask;
    }

    private async Task OnMonthInput(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString() ?? null, out var month))
            return;

        Current = new DateOnly(Current.Year, month, 1);

        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task OnYearInput(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString() ?? null, out var year))
            return;

        Current = new DateOnly(year, Current.Month, 1);

        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }
}
