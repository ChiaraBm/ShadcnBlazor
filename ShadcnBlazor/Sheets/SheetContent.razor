@using LucideBlazor
@inherits ShadcnBase

@if (Sheet.ShouldRenderContent)
{
    <SheetOverlay @onclick="Sheet.CloseAsync"/>

    <div data-slot="sheet-content"
         data-state="@(Sheet.IsOpen ? "open" : "closed")"
         class="@Classes"
         @attributes="Props">
        
        @ChildContent
        
        <button @onclick="Sheet.CloseAsync"
                type="button"
                class="hover:cursor-pointer ring-offset-background focus:ring-ring data-[state=open]:bg-secondary absolute top-4 right-4 rounded-xs opacity-70 transition-opacity hover:opacity-100 focus:ring-2 focus:ring-offset-2 focus:outline-hidden disabled:pointer-events-none">
            <XIcon ClassName="size-4" />
        </button>
    </div>
}

@code
{
    [CascadingParameter] public Sheet Sheet { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public SheetSide Side { get; set; } = SheetSide.Right;

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "bg-background data-[state=open]:animate-in data-[state=closed]:animate-out fixed z-50 flex flex-col gap-4 shadow-lg transition ease-in-out data-[state=closed]:duration-300 data-[state=open]:duration-500",
            GetSideCss(),
            ClassName
        );
    }

    private string GetSideCss()
    {
        return Side switch
        {
            SheetSide.Right => "data-[state=closed]:slide-out-to-right data-[state=open]:slide-in-from-right inset-y-0 right-0 h-full w-3/4 border-l sm:max-w-sm",
            SheetSide.Left => "data-[state=closed]:slide-out-to-left data-[state=open]:slide-in-from-left inset-y-0 left-0 h-full w-3/4 border-r sm:max-w-sm",
            SheetSide.Top => "data-[state=closed]:slide-out-to-top data-[state=open]:slide-in-from-top inset-x-0 top-0 h-auto border-b",
            SheetSide.Bottom => "data-[state=closed]:slide-out-to-bottom data-[state=open]:slide-in-from-bottom inset-x-0 bottom-0 h-auto border-t",
            _ => throw new ArgumentOutOfRangeException()
        };
    }
}