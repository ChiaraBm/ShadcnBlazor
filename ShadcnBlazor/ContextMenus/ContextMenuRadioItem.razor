@inherits ShadcnBase

@using LucideBlazor
@implements IContextMenuItem

<div data-slot="context-menu-radio-item"
     class="@Classes"
     checked="@Value"
     tabindex="-1"
     data-disabled="@Disabled"
     disabled="@Disabled"
     onmouseover="this.focus()"
     @onfocusin="() => Parent.ChangeFocusAsync(this)"
     @onclick="() => RadioGroup.ChangeValueAsync(Value)"
     @attributes="Props">
    
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
        @if (RadioGroup.Value == Value)
        {
            <CircleIcon ClassName="size-2 fill-current" />
        }
    </span>

    @ChildContent
</div>

@code
{
    [CascadingParameter] public ContextMenuRadioGroup RadioGroup { get; set; }
    [CascadingParameter] public IContextMenuParent Parent { get; set; }

    [Parameter] public string Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "focus:bg-accent focus:text-accent-foreground relative flex cursor-default items-center gap-2 rounded-sm py-1.5 pr-2 pl-8 text-sm outline-hidden select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
            ClassName
        );
    }

    public Task OnUnfocusAsync() => Task.CompletedTask;
}