@inherits ShadcnBase

<CascadingValue TValue="ContextMenuRadioGroup" Value="this">
    @ChildContent
</CascadingValue>

@code
{
    [CascadingParameter] public IContextMenuParent Parent { get; set; }
    
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public bool CloseOnClick { get; set; } = true;
    
    [Parameter]
    public string Value
    {
        get => _value;
        set
        {
            if (_value == value) return;

            _value = value;
            ValueChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private string _value;

    internal async Task ChangeValueAsync(string value)
    {
        Value = value;
        await InvokeAsync(StateHasChanged);
        
        if (CloseOnClick)
            await Parent.CloseMenuAsync();
    }
}