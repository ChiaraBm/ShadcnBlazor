@inherits ShadcnBase

<CascadingValue TValue="ContextMenuRadioGroup" Value="this">
    @ChildContent
</CascadingValue>

@code
{
    [CascadingParameter] public IContextMenuParent Parent { get; set; }
    
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public bool CloseOnClick { get; set; } = true;
    
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    internal async Task ChangeValueAsync(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        await InvokeAsync(StateHasChanged);
        
        if (CloseOnClick)
            await Parent.CloseMenuAsync();
    }
}