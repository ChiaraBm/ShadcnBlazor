@inherits ShadcnBase

@using LucideBlazor
@implements IContextMenuItem

<div data-slot="context-menu-checkbox-item"
     data-disabled="@Disabled"
     disabled="@Disabled"
     class="@Classes"
     tabindex="-1"
     checked="@Value"
     onmouseover="this.focus()"
     @onfocusin="() => Parent.ChangeFocusAsync(this)"
     @onclick="OnClickAsync"
     @attributes="Props">
    
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
        @if (Value)
        {
            <CheckIcon ClassName="size-4" />
        }
    </span>

    @ChildContent
</div>

@code
{
    [CascadingParameter] public IContextMenuParent Parent { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool CloseOnClick { get; set; } = true;

    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "focus:bg-accent focus:text-accent-foreground relative flex cursor-default items-center gap-2 rounded-sm py-1.5 pr-2 pl-8 text-sm outline-hidden select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
            ClassName
        );
    }

    private async Task OnClickAsync()
    {
        if(Disabled)
            return;

        Value = !Value;
        await ValueChanged.InvokeAsync(Value);
        await InvokeAsync(StateHasChanged);
        
        if (CloseOnClick)
            await Parent.CloseMenuAsync();
    }

    public Task OnUnfocusAsync() => Task.CompletedTask;
}