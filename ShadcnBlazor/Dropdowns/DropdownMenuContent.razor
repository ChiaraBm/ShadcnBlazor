@using ShadcnBlazor.Interop

@inherits ShadcnBase

@inject PositionService PositionService

@if (DropdownMenu.ShouldRenderContent)
{
    <div class="fixed inset-0 z-50" @onclick="DropdownMenu.CloseAsync">

    </div>

    <div @ref="PositionElement" class="min-w-max z-50 fixed top-0 left-0" style="@PositionStyle">
        <div data-slot="dropdown-menu-content"
             data-state="@(DropdownMenu.IsOpen ? "open" : "closed")"
             class="@Classes"
             @attributes="Props">
            @ChildContent
        </div>
    </div>
}

@code
{
    [CascadingParameter] public DropdownMenu DropdownMenu { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public PositionSide Side { get; set; } = PositionSide.Bottom;
    [Parameter] public PositionAlignment Align { get; set; } = PositionAlignment.Start;
    [Parameter] public double SideOffset { get; set; } = 12;

    private string? Classes;
    
    private ElementReference PositionElement;
    private string PositionStyle = PositionService.Position.OffCanvasCss;
    private bool IsPositined;

    protected override void OnInitialized()
    {
        DropdownMenu.Content = this;
    }

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "bg-popover text-popover-foreground data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 z-50 max-h-(--radix-dropdown-menu-content-available-height) min-w-[8rem] origin-(--radix-dropdown-menu-content-transform-origin) overflow-x-hidden overflow-y-auto rounded-md border p-1 shadow-md",
            ClassName
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (DropdownMenu.ShouldRenderContent && !IsPositined)
        {
            var position = await PositionService.PositionAroundAsync(
                DropdownMenu.Trigger.TriggerElement,
                PositionElement,
                Side,
                Align,
                SideOffset
            );

            PositionStyle = position.ToCssStyle();
            IsPositined = true;

            await InvokeAsync(StateHasChanged);
        }
        else
            IsPositined = false;
    }
}
