@inherits ShadcnBase

<div data-slot="dropdown-menu-checkbox-item"
     class="@Classes"
     checked="@Value"
     tabindex="-1"
     data-disabled="@Disabled"
     disabled="@Disabled"
     onmouseover="this.focus()"
     @onclick="OnClickAsync"
     @attributes="Props">
    
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
        @if (Value)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="lucide lucide-check-icon lucide-check size-4"><path d="M20 6 9 17l-5-5"/></svg>
        }
    </span>

    @ChildContent
</div>

@code
{
    [CascadingParameter] public IDropdownMenuParent Parent { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool CloseOnClick { get; set; } = true;
    [Parameter] public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool Value
    {
        get => _value;
        set
        {
            if (_value == value) return;

            _value = value;
            ValueChanged.InvokeAsync(value);
        }
    }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private bool _value;

    private string? Classes;

    protected override void OnParametersSet()
    {
        Classes = Cn(
            "focus:bg-accent focus:text-accent-foreground relative flex cursor-default items-center gap-2 rounded-sm py-1.5 pr-2 pl-8 text-sm outline-hidden select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
            ClassName
        );
    }

    private async Task OnClickAsync()
    {
        if (Disabled)
            return;

        Value = !Value;
        await InvokeAsync(StateHasChanged);

        if (CloseOnClick)
            await Parent.CloseMenuAsync();
    }
}
