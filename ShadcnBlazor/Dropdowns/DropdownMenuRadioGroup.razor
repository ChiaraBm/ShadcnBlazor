@inherits ShadcnBase

<CascadingValue TValue="DropdownMenuRadioGroup" Value="this">
    @ChildContent
</CascadingValue>

@code
{
    [CascadingParameter] public IDropdownMenuParent Parent { get; set; }
    
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public bool CloseOnClick { get; set; } = true;
    
    [Parameter]
    public string Value
    {
        get => _value;
        set
        {
            if (_value == value) return;

            _value = value;
            ValueChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private string _value;

    internal async Task ChangeValueAsync(string value)
    {
        Value = value;
        await InvokeAsync(StateHasChanged).ContinueWith(async _ =>
        {
            await Task.Delay(50);
            
            if (CloseOnClick)
                await Parent.CloseMenuAsync();
        });
    }
}