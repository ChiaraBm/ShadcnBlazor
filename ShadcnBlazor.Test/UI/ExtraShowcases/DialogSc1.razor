@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.Dialogs
@using ShadcnBlazor.Test.UI.ExtraShowcases.Components

@inject DialogService DialogService

<Button @onclick="DoAsync" Variant="ButtonVariant.Outline">Launch dialog</Button>

@code
{
    private async Task DoAsync() => await DialogService.LaunchAsync<ExampleDialog>(onConfigure: model =>
    {
        model.ClassName = "sm:max-w-lg";
    });
}