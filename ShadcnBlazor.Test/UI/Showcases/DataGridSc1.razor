@using LucideBlazor
@using ShadcnBlazor.Alerts
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.DataGrids
@using ShadcnBlazor.Dropdowns
@using ShadcnBlazor.Interop
@using ShadcnBlazor.Tabels

<div>
    Selected @Selected.Count
</div>

<DataGrid TGridItem="Payment" Loader="LoadAsync" PageSize="5" EnableSearch="true">
    <SelectColumn Items="Selected" OnChanged="() => InvokeAsync(StateHasChanged)"/>

    <PropertyColumn Field="payment => payment.Id"/>
    <PropertyColumn Field="payment => payment.Success"/>
    <PropertyColumn IsFilterable="true" Identifier="Email"
                    Field="payment => payment.Email"/>
    <PropertyColumn Field="payment => payment.Amount"/>
    <TemplateColumn Title="Actions" DefaultVisible="false">
        <CellTemplate>
            <TableCell ClassName="flex justify-end items-center">
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm">
                        <PlayIcon/>
                    </Button>
                    <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.IconSm">
                        <SquareIcon/>
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm">
                        <SquareArrowOutUpRightIcon/>
                    </Button>
                </ButtonGroup>
            </TableCell>
        </CellTemplate>
    </TemplateColumn>
    <TemplateColumn>
        <CellTemplate>
            <DropdownMenu>
                <TableCell>
                    <DropdownMenuTrigger>
                        <Slot Context="dropdownContext">
                            <div class="flex justify-end items-center me-5">
                                <Button ClassName="h-8 w-8 p-0" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm"
                                        @attributes="dropdownContext">
                                    <EllipsisIcon/>
                                </Button>
                            </div>

                        </Slot>
                    </DropdownMenuTrigger>
                </TableCell>
                <DropdownMenuContent Align="PositionAlignment.End">
                    <DropdownMenuItem>Edit</DropdownMenuItem>
                    <DropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
                        Delete
                    </DropdownMenuItem>
                </DropdownMenuContent>
            </DropdownMenu>
        </CellTemplate>
    </TemplateColumn>
</DataGrid>

@code
{
    private readonly List<Payment> Payments = new();
    private const int ItemAmount = 100;

    private readonly List<Payment> Selected = new();

    protected override void OnInitialized()
    {
        Payments.EnsureCapacity(ItemAmount);

        for (var i = 1; i <= ItemAmount; i++)
        {
            Payments.Add(new Payment(
                i,
                $"user{i}@example.com",
                Random.Shared.Next(0, 2) == 1,
                Math.Round(Random.Shared.NextDouble() * 100, 2)
            ));
        }
    }

    record Payment(int Id, string Email, bool Success, double Amount);

    private async Task<DataGridResponse<Payment>> LoadAsync(DataGridRequest<Payment> request)
    {
        await Task.Delay(1000);

        IEnumerable<Payment> items = Payments;

        foreach (var filter in request.Filters)
        {
            items = filter.Key switch
            {
                nameof(Payment.Email) => items.Where(x => x.Email.Contains(filter.Value, StringComparison.OrdinalIgnoreCase)),
                _ => items
            };
        }

        if (!string.IsNullOrWhiteSpace(request.SearchTerm))
            items = items.Where(x => x.Email.Contains(request.SearchTerm, StringComparison.OrdinalIgnoreCase));

        var data = items
            .Skip(request.StartIndex)
            .Take(request.Length)
            .ToArray();

        return new DataGridResponse<Payment>(data, Payments.Count);
    }
}
