@page "/extras"
@using ShadcnBlazor.Items

<h1 class="text-xl font-semibold">Extra Components</h1>
<div class="text-muted-foreground">
    Here you can find components created specially for ShadcnBlazor and cannot be found in the original shadcn library
</div>

<div class="grid grid-col-1 md:grid-cols-4 2xl:grid-cols-6 gap-8 mt-8">
    @foreach (var item in Items)
    {
        <div class="col-span-1">

            @if (item.InProgress)
            {
                <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm"
                      ClassName="pointer-events-none opacity-50 w-full">
                    <Slot>
                        <div @attributes="context">
                            <ItemContent>
                                <ItemTitle>@item.Name</ItemTitle>
                            </ItemContent>
                            <ItemActions>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round"
                                     class="lucide lucide-chevron-right-icon lucide-chevron-right size-4">
                                    <path d="m9 18 6-6-6-6"/>
                                </svg>
                            </ItemActions>
                        </div>
                    </Slot>
                </Item>
            }
            else
            {
                <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm" ClassName="w-full">
                    <Slot>
                        <a href="/extras/@item.Url" @attributes="context">
                            <ItemContent>
                                <ItemTitle>@item.Name</ItemTitle>
                            </ItemContent>
                            <ItemActions>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round"
                                     class="lucide lucide-chevron-right-icon lucide-chevron-right size-4">
                                    <path d="m9 18 6-6-6-6"/>
                                </svg>
                            </ItemActions>
                        </a>
                    </Slot>
                </Item>
            }
        </div>
    }
</div>

@code
{
    private readonly List<ComponentItem> Items =
    [
        new(false, "lazyLoader", "Lazy Loader"),
        new(false, "alert", "Alert"),
        new(false, "alertDialog", "Alert Dialog"),
        new(false, "wbutton", "Worker Button"),
        new(false, "toast", "Toast"),
        new(false, "inputTags", "Input Tags"),
    ];

    record ComponentItem(bool InProgress, string Url, string Name);
}
