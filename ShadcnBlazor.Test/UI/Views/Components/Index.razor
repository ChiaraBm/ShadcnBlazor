@page "/components"
@using LucideBlazor
@using ShadcnBlazor.Items

<h1 class="text-xl font-semibold">Components</h1>
<div class="text-muted-foreground">
    Here you can find all the components available in the library. We are working on porting more components.
</div>

<div class="grid grid-col-1 md:grid-cols-4 2xl:grid-cols-6 gap-8 mt-8">
    @foreach (var item in Items)
    {
        <div class="col-span-1">

            @if (item.InProgress)
            {
                <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm"
                      ClassName="pointer-events-none opacity-50 w-full">
                    <Slot>
                        <div @attributes="context">
                            <ItemContent>
                                <ItemTitle>@item.Name</ItemTitle>
                            </ItemContent>
                            <ItemActions>
                                <ChevronRightIcon ClassName="size-4"/>
                            </ItemActions>
                        </div>
                    </Slot>
                </Item>
            }
            else
            {
                <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm" ClassName="w-full">
                    <Slot>
                        <a href="/components/@item.Url" @attributes="context">
                            <ItemContent>
                                <ItemTitle>@item.Name</ItemTitle>
                            </ItemContent>
                            <ItemActions>
                                <ChevronRightIcon ClassName="size-4" />
                            </ItemActions>
                        </a>
                    </Slot>
                </Item>
            }
        </div>
    }
</div>

