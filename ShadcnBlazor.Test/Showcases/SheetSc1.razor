@using ShadcnBlazor.Sheets
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Inputs
@using ShadcnBlazor.Labels

<Sheet>
    <SheetTrigger>
        <Slot>
            <Button Variant="ButtonVariant.Outline" @attributes="context">Open</Button>
        </Slot>
    </SheetTrigger>
    <SheetContent>
        <SheetHeader>
            <SheetTitle>Edit profile</SheetTitle>
            <SheetDescription>
                Make changes to your profile here. Click save when you&apos;re done.
            </SheetDescription>
        </SheetHeader>
        <div class="grid flex-1 auto-rows-min gap-6 px-4">
            <div class="grid gap-3">
                <Label for="sheet-demo-name">Name</Label>
                <TextInputField id="sheet-demo-name" Value="Pedro Duarte" />
            </div>
            <div class="grid gap-3">
                <Label for="sheet-demo-username">Username</Label>
                <TextInputField id="sheet-demo-username" Value="@("@peduarte")" />
            </div>
        </div>
        <SheetFooter>
            <Button type="submit">Save changes</Button>
            <SheetClose>
                <Slot>
                    <Button Variant="ButtonVariant.Outline" @attributes="context">Close</Button>
                </Slot>
            </SheetClose>
        </SheetFooter>
    </SheetContent>
</Sheet>