@using ShadcnBlazor.ScrollArea
@using ShadcnBlazor.Separators

<div class="mt-5">
    <span class="underline-offset-4 group-hover:underline font-extrabold text-2xl">Vertical</span>
    <p>Use <code>ScrollBar</code> with <code>Orientation="@ScrollBarOrientation.Vertical"</code> for vertical scrolling.</p>
</div>

<div class="group relative mt-4 mb-12 flex flex-col">
<ScrollArea ScrollAreaDirection="ScrollAreaDirection.Ltr" ScrollAreaType="ScrollAreaType.Always" ClassName="h-72 w-48 rounded-md border">
    <div class="p-4">
        <h4 class="mb-4 text-sm leading-none font-medium">Items</h4>
        @foreach (var item in Items)
        {
            <div class="text-sm">
                @item
            </div>
            <Separator ClassName="my-2"/>
        }
    </div>
</ScrollArea>
</div>

<div class="mt-5">
    <span class="underline-offset-4 group-hover:underline font-extrabold text-2xl">Horizontal</span>
    <p>Use <code>ScrollBar</code> with <code>Orientation="@ScrollBarOrientation.Horizontal"</code> for horizontal scrolling.</p>
</div>

<div class="group relative mt-4 mb-12 flex flex-col">
    <ScrollArea ScrollAreaDirection="ScrollAreaDirection.Ltr"  ScrollAreaType="ScrollAreaType.Always" ClassName="rounded-md border whitespace-nowrap w-80">
        <div class="flex w-max space-x-4 p-4">
            @foreach (var item in Items)
            {
                <div class="shrink-0">
                    <div class="overflow-hidden rounded-md">
                        @item
                    </div>
                </div>
            }
        </div>
        <ScrollBar
            Orientation="@ScrollBarOrientation.Horizontal"
        />
    </ScrollArea>
</div>

