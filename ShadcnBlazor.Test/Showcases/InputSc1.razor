@using ShadcnBlazor.Inputs

<div class="flex flex-col gap-5">
    <TextInputField @bind-Value="Text" placeholder="Text" />
    <TextInputField @bind-Value="Email" type="email" placeholder="Email" />
    <TextInputField @bind-Value="Password" type="password" placeholder="Password" />
    <DateTimeInputField @bind-Value="DateTime" />
    <DateInputField @bind-Value="Date" />
    <NumberInputField @bind-Value="Number"  />
    <TextareaInputField @bind-Value="Textarea" placeholder="Textarea" />
</div>

@code
{
    private string Text;
    private string Email;
    private string Password;
    private DateTimeOffset DateTime;
    private DateOnly Date;
    private int Number;
    private string Textarea;
}
