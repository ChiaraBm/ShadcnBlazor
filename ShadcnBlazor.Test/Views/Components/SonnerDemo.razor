@page "/components/sonner"
@using LucideBlazor
@using ShadcnBlazor.Alerts
@using ShadcnBlazor.Test.Components
@using ShadcnBlazor.Test.Showcases

<!-- Page header -->
<header>
    <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">Components</div>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Sonner</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">
        An opinionated toast component for Blazor.
    </p>
</header>

<Alert ClassName="mt-5">
    <TriangleAlertIcon/>
    <AlertTitle>
        The main library only includes Sonners as base components. An interactive way to launch them can be found in the ShadcnBlazor.Extra package
    </AlertTitle>
</Alert>

<div class="mt-8">
    <div class="max-w-6xl">
        <Showcase Folder="Showcases" T="SonnerSc1" />
    </div>
</div>