@page "/installation"

@using LucideBlazor
@using ShadcnBlazor.Cards

<!-- Page header -->
<header>
    <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">@Translations.Views_Installation_PageKicker</div>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">@Translations.Views_Installation_PageTitle</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">
        @Translations.Views_Installation_IntroText
    </p>
</header>

<!-- Set up Tailwind -->
<section class="mt-16">
    <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">@Translations.Views_Installation_TailwindKicker</div>
    <h2 class="mt-3 text-2xl font-bold tracking-tight">@Translations.Views_Installation_StylingPipelineHeading</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
        @Translations.Views_Installation_StylingPipelineIntro
    </p>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        1
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_CreateStylesFolderTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_CreateStylesFolderDescription
                </CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.NpmInitContent</code></pre>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        2
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_InstallTailwindPostcssTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_InstallTailwindPostcssDescription</CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.NpmInstallPostcssContent</code></pre>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        3
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_CreatePostCssConfigTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_CreatePostCssConfigDescription
                </CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.PostCssContent</code></pre>
            </CardContent>
        </Card>

    </div>
</section>

<!-- Install ShadcnBlazor -->
<section class="mt-16">
    <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">@Translations.Views_Installation_NuGetKicker</div>
    <h2 class="mt-3 text-2xl font-bold tracking-tight">@Translations.Views_Installation_InstallShadcnBlazorHeading</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
        @Translations.Views_Installation_InstallIntro
    </p>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        4
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_AddNuGetPackageTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_AddNuGetPackageDescription
                </CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.InstallNugetContent</code></pre>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        5
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_AddPortalOutletTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_AddPortalOutletDescription
                </CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.PortalRazor</code></pre>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        6
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_RegisterServicesTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_RegisterServicesDescription</CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.ServiceCollectionContent</code></pre>
            </CardContent>
        </Card>
    </div>
</section>

<!-- Base styles & build -->
<section class="mt-16">
    <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">@Translations.Views_Installation_BaseStylesKicker</div>
    <h2 class="mt-3 text-2xl font-bold tracking-tight">@Translations.Views_Installation_BaseStylesHeading</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
        @Translations.Views_Installation_BaseStylesIntro
    </p>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">

        <Card ClassName="lg:col-span-2">
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        7
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_CreateStylesCssTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_CreateStylesCssDescription
                </CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.StylesContent</code></pre>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        8
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_UpdateIndexHtmlTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_UpdateIndexHtmlDescription
                </CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.HtmlContent</code></pre>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardAction>
                    <div
                        class="flex size-8 items-center justify-center rounded-full bg-violet-500/15 text-sm font-semibold text-violet-400">
                        9
                    </div>
                </CardAction>
                <CardTitle>@Translations.Views_Installation_BuildStylesTitle</CardTitle>
                <CardDescription>@Translations.Views_Installation_BuildStylesDescription</CardDescription>
            </CardHeader>
            <CardContent>
                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-sm"><code
                        class="font-mono">@Constants.BuildCommandContent</code></pre>
            </CardContent>
        </Card>

    </div>
</section>

<!-- Next steps -->
<section class="mt-16">
    <h2 class="text-2xl font-bold tracking-tight">@Translations.Views_Installation_NextStepsHeading</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
        @Translations.Views_Installation_NextStepsIntro
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
        <a href="/components" class="block">
            <Card ClassName="h-full transition-colors hover:border-violet-500/40">
                <CardContent ClassName="flex items-center gap-4">
                    <div
                        class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-violet-500/15 text-violet-400">
                        <ShapesIcon ClassName="size-6"/>
                    </div>
                    <div class="grow">
                        <CardTitle>@Translations.Views_Installation_ComponentsTitle</CardTitle>
                        <CardDescription>@Translations.Views_Installation_ComponentsDescription</CardDescription>
                    </div>
                </CardContent>
            </Card>
        </a>
        <a href="/extras" class="block">
            <Card ClassName="h-full transition-colors hover:border-fuchsia-500/40">
                <CardContent ClassName="flex items-center gap-4">
                    <div
                        class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-fuchsia-500/15 text-fuchsia-400">
                        <SparklesIcon ClassName="size-6"/>
                    </div>
                    <div class="grow">
                        <CardTitle>@Translations.Views_Installation_ExtrasTitle</CardTitle>
                        <CardDescription>@Translations.Views_Installation_ExtrasDescription</CardDescription>
                    </div>
                </CardContent>
            </Card>
        </a>
        <a href="/blocks" class="block">
            <Card ClassName="h-full transition-colors hover:border-violet-500/40">
                <CardContent ClassName="flex items-center gap-4">
                    <div
                        class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-violet-500/15 text-violet-400">
                        <BlocksIcon ClassName="size-6"/>
                    </div>
                    <div class="grow">
                        <CardTitle>@Translations.Views_Installation_BlocksTitle</CardTitle>
                        <CardDescription>@Translations.Views_Installation_BlocksDescription</CardDescription>
                    </div>
                </CardContent>
            </Card>
        </a>
    </div>
</section>

