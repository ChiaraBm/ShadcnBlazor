@page "/extras"
@using LucideBlazor
@using ShadcnBlazor.Cards
@using ShadcnBlazor.Badges

<!-- Page header -->
<header>
    <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">Library</div>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Extra Components</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">
        Here you can find components created specially for ShadcnBlazor that cannot be found in the original shadcn library.
    </p>
</header>

<!-- Stats -->
<div class="mt-6 flex flex-wrap gap-2">
    <Badge Variant="BadgeVariant.Secondary" ClassName="gap-1.5 py-1">
        <span class="size-1.5 rounded-full bg-violet-400"></span>
        @ReadyCount available
    </Badge>
    <Badge Variant="BadgeVariant.Secondary" ClassName="gap-1.5 py-1">
        <span class="size-1.5 animate-pulse rounded-full bg-violet-400"></span>
        @InProgressCount in progress
    </Badge>
</div>

<!-- Grid -->
<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    @foreach (var item in Items)
    {
        if (item.InProgress)
        {
            <div class="block h-full">
                <Card ClassName="h-full opacity-50">
                    <CardContent ClassName="flex items-center gap-4">
                        @IconTileFor(item)
                        <div class="grow min-w-0">
                            <CardTitle ClassName="truncate">@item.Name</CardTitle>
                            <CardDescription>Coming soon</CardDescription>
                        </div>
                        <span class="size-2 shrink-0 animate-pulse rounded-full bg-violet-400"></span>
                    </CardContent>
                </Card>
            </div>
        }
        else
        {
            <a href="/extras/@item.Url" class="block h-full">
                <Card ClassName="group h-full transition-colors hover:border-violet-500/40">
                    <CardContent ClassName="flex items-center gap-4">
                        @IconTileFor(item)
                        <div class="grow min-w-0">
                            <CardTitle ClassName="truncate">@item.Name</CardTitle>
                        </div>
                        <ChevronRightIcon ClassName="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" />
                    </CardContent>
                </Card>
            </a>
        }
    }
</div>

@code
{
    // Renders the violet icon tile for the given item.
    private RenderFragment IconTileFor(ComponentItem item) => @<div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-violet-500/15 text-violet-400 transition-colors group-hover:bg-violet-500/25">
        <DynamicComponent Type="item.IconType" Parameters="IconParameters" />
    </div>;

    private static readonly Dictionary<string, object> IconParameters = new()
    {
        ["ClassName"] = "size-6"
    };

    private int ReadyCount => Items.Count(i => !i.InProgress);
    private int InProgressCount => Items.Count(i => i.InProgress);

    private readonly List<ComponentItem> Items =
    [
        new(false, "lazyLoader", "Lazy Loader", typeof(LoaderCircleIcon)),
        new(false, "alert", "Alert", typeof(CircleCheckBigIcon)),
        new(false, "alertDialog", "Alert Dialog", typeof(CircleAlertIcon)),
        new(false, "wbutton", "Worker Button", typeof(WrenchIcon)),
        new(false, "toast", "Toast", typeof(BellIcon)),
        new(false, "inputTags", "Input Tags", typeof(FileBracesIcon)),
        new(false, "crashHandler", "Crash Handler", typeof(CircleAlertIcon)),
        new(false, "dialog", "Dialog", typeof(FileTextIcon)),
        new(false, "formHandler", "Form Handler", typeof(FileTextIcon)),
        new(false, "combobox", "Combobox", typeof(SearchIcon)),
        new(false, "fileDropzone", "File Dropzone", typeof(CloudUploadIcon)),
        new(false, "editor", "Editor", typeof(FileCodeIcon)),
        new(false, "fileManager", "File Manager", typeof(FolderIcon))
    ];

    record ComponentItem(bool InProgress, string Url, string Name, Type IconType);
}
