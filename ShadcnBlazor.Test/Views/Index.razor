@page "/"
@using ShadcnBlazor.Test.Partials

@layout EmptyLayout

@using LucideBlazor
@using ShadcnBlazor.Accordions
@using ShadcnBlazor.Alerts
@using ShadcnBlazor.Avatars
@using ShadcnBlazor.Badges
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Cards
@using ShadcnBlazor.Checkboxes
@using ShadcnBlazor.Inputs
@using ShadcnBlazor.Interop
@using ShadcnBlazor.Items
@using ShadcnBlazor.Kbds
@using ShadcnBlazor.Labels
@using ShadcnBlazor.Paginations
@using ShadcnBlazor.Progresses
@using ShadcnBlazor.RadioGroups
@using ShadcnBlazor.Selects
@using ShadcnBlazor.Separators
@using ShadcnBlazor.Skeletons
@using ShadcnBlazor.Sliders
@using ShadcnBlazor.Spinners
@using ShadcnBlazor.Switches
@using ShadcnBlazor.Tab
@using ShadcnBlazor.Test.Components
@using ShadcnBlazor.Toggles
@using ShadcnBlazor.Tooltips

@implements IDisposable

<div class="relative">

    <!-- Hero -->
    <section class="relative overflow-hidden rounded-3xl border bg-card/50 px-6 py-16 text-center sm:py-20">
        <div
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgb(255_255_255/0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.03)_1px,transparent_1px)] bg-[size:44px_44px] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_0%,black,transparent)]"></div>
        <div
            class="pointer-events-none absolute -top-32 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-violet-600/25 blur-3xl"></div>

        <div class="relative">
            <img
                src="/_content/ShadcnBlazor.Test/shadcnblazor.svg"
                alt="ShadcnBlazor logo"
                class="mx-auto size-24 drop-shadow-[0_0_25px_rgba(124,58,237,0.45)]"/>

            <h1 class="mt-8 text-5xl font-bold tracking-tight sm:text-6xl">
                Shadcn<span
                    class="bg-gradient-to-r from-violet-400 via-fuchsia-400 to-violet-400 bg-clip-text text-transparent">Blazor</span>
            </h1>

            <p class="mx-auto mt-5 max-w-2xl text-balance text-lg text-muted-foreground">
                @Translations.Views_Index_HeroTaglinePrefix
                <a href="https://ui.shadcn.com/"
                   class="text-violet-400 underline-offset-4 hover:underline">shadcn/ui</a>
                @Translations.Views_Index_HeroTaglineSuffix
            </p>

            <div class="mt-7 flex flex-wrap items-center justify-center gap-2">
                <Badge>.NET 9</Badge>
                <Badge Variant="BadgeVariant.Secondary">@Translations.Views_Index_HeroBadgeTailwind</Badge>
                <Badge Variant="BadgeVariant.Secondary">@Translations.Views_Index_HeroBadgeMitLicense</Badge>
                <Badge Variant="BadgeVariant.Outline">@Translations.Views_Index_HeroBadgeComponents</Badge>
            </div>

            <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
                <Button Size="ButtonSize.Lg">
                    <Slot>
                        <a href="/installation" @attributes="context">
                            @Translations.Views_Index_HeroButtonGetStarted
                            <ArrowRightIcon/>
                        </a>
                    </Slot>
                </Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Lg">
                    <Slot>
                        <a href="/components" @attributes="context">@Translations.Views_Index_HeroButtonBrowseComponents</a>
                    </Slot>
                </Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Lg">
                    <Slot>
                        <a href="/blocks" @attributes="context">
                            @Translations.Views_Index_HeroButtonBlocks
                            <ArrowRightIcon/>
                        </a>
                    </Slot>
                </Button>
            </div>

            <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-sm text-muted-foreground">
                <div class="flex items-center gap-2">
                    <ShapesIcon class="size-4 text-violet-400"/>
                    @Translations.Views_Index_HeroStatCoreComponents
                </div>
                <div class="flex items-center gap-2">
                    <SparklesIcon class="size-4 text-violet-400"/>
                    @Translations.Views_Index_HeroStatExtras
                </div>
                <div class="flex items-center gap-2">
                    <BlocksIcon class="size-4 text-violet-400"/>
                    @Translations.Views_Index_HeroStatNuGetPackages
                </div>
            </div>
        </div>
    </section>

    <!-- What is ShadcnBlazor -->
    <section class="mt-24">
        <div class="grid items-center gap-10 lg:grid-cols-2">
            <div>
                <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">@Translations.Views_Index_WhatIs_Eyebrow</div>
                <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                    @Translations.Views_Index_WhatIs_Title
                </h2>
                <p class="mt-5 text-muted-foreground">
                    @Translations.Views_Index_WhatIs_Description
                    <a href="/blocks" class="text-violet-400 underline-offset-4 hover:underline">@Translations.Views_Index_WhatIs_LiveDemo</a>.
                </p>
                <p class="mt-4 text-muted-foreground">
                    @Translations.Views_Index_WhatIs_Styling
                </p>
            </div>

            <div class="grid gap-4">
                <Card ClassName="transition-colors hover:border-violet-500/40">
                    <CardContent>
                        <a class="flex items-center gap-4" href="/components">
                            <div
                                class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-violet-500/15 text-violet-400">
                                <PackageOpenIcon ClassName="size-6"/>
                            </div>
                            <div>
                                <CardTitle>ShadcnBlazor</CardTitle>
                                <CardDescription>@Translations.Views_Index_WhatIs_CoreDescription
                                </CardDescription>
                            </div>
                        </a>
                    </CardContent>
                </Card>
                <Card ClassName="transition-colors hover:border-fuchsia-500/40">
                    <CardContent>
                        <a class="flex items-center gap-4" href="/components">
                            <div
                                class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-fuchsia-500/15 text-fuchsia-400">
                                <SparklesIcon ClassName="size-6"/>
                            </div>
                            <div>
                                <CardTitle>ShadcnBlazor.Extras</CardTitle>
                                <CardDescription>@Translations.Views_Index_WhatIs_ExtrasDescription
                                </CardDescription>
                            </div>
                        </a>
                    </CardContent>
                </Card>
            </div>
        </div>
    </section>

    <!-- Component gallery -->
    <section class="mt-24">
        <div class="mx-auto max-w-2xl text-center">
            <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">@Translations.Views_Index_Gallery_Eyebrow</div>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">@Translations.Views_Index_Gallery_Title</h2>
            <p class="mt-4 text-muted-foreground">
                @Translations.Views_Index_Gallery_Description
            </p>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-3">

            <!-- Button -->
            <Card ClassName="md:col-span-2">
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryButtonTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryButtonDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="flex flex-wrap items-center gap-2">
                        <Button>@Translations.Views_Index_GalleryButtonDefault</Button>
                        <Button Variant="ButtonVariant.Secondary">@Translations.Views_Index_GalleryButtonSecondary</Button>
                        <Button Variant="ButtonVariant.Outline">@Translations.Views_Index_GalleryButtonOutline</Button>
                        <Button Variant="ButtonVariant.Ghost">@Translations.Views_Index_GalleryButtonGhost</Button>
                        <Button Variant="ButtonVariant.Destructive">@Translations.Views_Index_GalleryButtonDestructive</Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="@Translations.Views_Index_GalleryButtonSubmitAria">
                            <ArrowUpIcon/>
                        </Button>
                    </div>
                </CardContent>
            </Card>

            <!-- Badge -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryBadgeTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryBadgeDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="flex flex-wrap gap-2">
                        <Badge>@Translations.Views_Index_GalleryBadgeDefault</Badge>
                        <Badge Variant="BadgeVariant.Secondary">@Translations.Views_Index_GalleryBadgeSecondary</Badge>
                        <Badge Variant="BadgeVariant.Destructive">@Translations.Views_Index_GalleryBadgeDestructive</Badge>
                        <Badge Variant="BadgeVariant.Outline">@Translations.Views_Index_GalleryBadgeOutline</Badge>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <Badge Variant="BadgeVariant.Secondary" ClassName="bg-violet-500/15 text-violet-400">
                            <SparklesIcon ClassName="size-3"/>
                            @Translations.Views_Index_GalleryBadgeNew
                        </Badge>
                        <Badge ClassName="h-5 min-w-5 rounded-full px-1 font-mono tabular-nums">8</Badge>
                        <Badge
                            Variant="BadgeVariant.Destructive"
                            ClassName="h-5 min-w-5 rounded-full px-1 font-mono tabular-nums">
                            99
                        </Badge>
                    </div>
                </CardContent>
            </Card>

            <!-- Input -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryInputTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryInputDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="grid gap-4">
                        <div class="grid gap-2">
                            <Label for="hero-email">@Translations.Views_Index_GalleryInputEmailLabel</Label>
                            <TextInputField @bind-Value="Email" id="hero-email" Type="email"
                                            placeholder="m@example.com"/>
                        </div>
                        <div class="grid gap-2">
                            <Label for="hero-password">@Translations.Views_Index_GalleryInputPasswordLabel</Label>
                            <TextInputField @bind-Value="Password" id="hero-password" Type="password"
                                            placeholder="••••••••"/>
                        </div>
                    </div>
                </CardContent>
            </Card>

            <!-- Switch & Checkbox -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GallerySwitchTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GallerySwitchDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="flex flex-col gap-4">
                        <div class="flex items-center gap-3">
                            <Switch @bind-Value="SwitchValue" id="hero-switch"/>
                            <Label for="hero-switch">@Translations.Views_Index_GallerySwitchNotificationsLabel</Label>
                        </div>
                        <div class="flex items-center gap-3">
                            <Checkbox @bind-Value="CheckboxValue" id="hero-checkbox"/>
                            <Label for="hero-checkbox">@Translations.Views_Index_GallerySwitchAcceptTermsLabel</Label>
                        </div>
                    </div>
                </CardContent>
            </Card>

            <!-- Radio Group -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryRadioTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryRadioDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <RadioGroup DefaultValue="comfortable">
                        <div class="flex items-center gap-3">
                            <RadioGroupItem Value="default" id="hero-radio-1"/>
                            <Label for="hero-radio-1">@Translations.Views_Index_GalleryRadioDefault</Label>
                        </div>
                        <div class="flex items-center gap-3">
                            <RadioGroupItem Value="comfortable" id="hero-radio-2"/>
                            <Label for="hero-radio-2">@Translations.Views_Index_GalleryRadioComfortable</Label>
                        </div>
                        <div class="flex items-center gap-3">
                            <RadioGroupItem Value="compact" id="hero-radio-3"/>
                            <Label for="hero-radio-3">@Translations.Views_Index_GalleryRadioCompact</Label>
                        </div>
                    </RadioGroup>
                </CardContent>
            </Card>

            <!-- Slider -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GallerySliderTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GallerySliderDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="mb-3 text-sm text-muted-foreground">@Translations.Views_Index_GallerySliderValueLabel@SliderValue</div>
                    <Slider Min="0" Max="100" @bind-Value="SliderValue"/>
                </CardContent>
            </Card>

            <!-- Progress -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryProgressTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryProgressDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="mb-3 text-sm text-muted-foreground">@ProgressValue%</div>
                    <Progress Value="ProgressValue" Max="100"/>
                </CardContent>
            </Card>

            <!-- Tabs -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryTabsTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryTabsDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Tabs DefaultValue="account">
                        <TabsList>
                            <TabsTrigger Value="account">@Translations.Views_Index_GalleryTabsAccountTrigger</TabsTrigger>
                            <TabsTrigger Value="password">@Translations.Views_Index_GalleryTabsPasswordTrigger</TabsTrigger>
                        </TabsList>
                        <TabsContent Value="account">
                            <p class="text-sm text-muted-foreground">
                                @Translations.Views_Index_GalleryTabsAccountBody
                            </p>
                        </TabsContent>
                        <TabsContent Value="password">
                            <p class="text-sm text-muted-foreground">
                                @Translations.Views_Index_GalleryTabsPasswordBody
                            </p>
                        </TabsContent>
                    </Tabs>
                </CardContent>
            </Card>

            <!-- Accordion -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryAccordionTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryAccordionDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Accordion Type="AccordionType.Single" DefaultValue="item-1" ClassName="w-full">
                        <AccordionItem Value="item-1">
                            <AccordionTrigger>@Translations.Views_Index_GalleryAccordionAccessibleTrigger</AccordionTrigger>
                            <AccordionContent>
                                @Translations.Views_Index_GalleryAccordionAccessibleContent
                            </AccordionContent>
                        </AccordionItem>
                        <AccordionItem Value="item-2">
                            <AccordionTrigger>@Translations.Views_Index_GalleryAccordionStyledTrigger</AccordionTrigger>
                            <AccordionContent>
                                @Translations.Views_Index_GalleryAccordionStyledContent
                            </AccordionContent>
                        </AccordionItem>
                    </Accordion>
                </CardContent>
            </Card>

            <!-- Alert -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryAlertTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryAlertDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Alert>
                        <CircleCheckBigIcon/>
                        <AlertTitle>@Translations.Views_Index_GalleryAlertSuccessTitle</AlertTitle>
                        <AlertDescription>
                            @Translations.Views_Index_GalleryAlertSuccessDescription
                        </AlertDescription>
                    </Alert>
                </CardContent>
            </Card>

            <!-- Avatar -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryAvatarTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryAvatarDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="flex items-center gap-3">
                        <Avatar>
                            <AvatarImage src="https://github.com/shadcn.png" alt="@("@shadcn")"/>
                            <AvatarFallback>CN</AvatarFallback>
                        </Avatar>
                        <Avatar>
                            <AvatarImage src="https://github.com/evilrabbit.png" alt="@("@evilrabbit")"/>
                            <AvatarFallback>ER</AvatarFallback>
                        </Avatar>
                        <Avatar>
                            <AvatarFallback>CB</AvatarFallback>
                        </Avatar>
                    </div>
                </CardContent>
            </Card>

            <!-- Skeleton -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GallerySkeletonTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GallerySkeletonDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="flex items-center gap-4">
                        <Skeleton ClassName="size-12 rounded-full"/>
                        <div class="space-y-2">
                            <Skeleton ClassName="h-4 w-40"/>
                            <Skeleton ClassName="h-4 w-28"/>
                        </div>
                    </div>
                </CardContent>
            </Card>

            <!-- Kbd -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryKbdTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryKbdDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="flex flex-col items-start gap-3">
                        <KbdGroup>
                            <Kbd>Ctrl</Kbd>
                            <span>+</span>
                            <Kbd>K</Kbd>
                        </KbdGroup>
                        <KbdGroup>
                            <Kbd>⌘</Kbd>
                            <Kbd>⇧</Kbd>
                            <Kbd>⌥</Kbd>
                        </KbdGroup>
                    </div>
                </CardContent>
            </Card>

            <!-- Tooltip -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryTooltipTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryTooltipDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Tooltip>
                        <TooltipTrigger>
                            <Slot>
                                <Button Variant="ButtonVariant.Outline" @attributes="context">@Translations.Views_Index_GalleryTooltipHoverMe</Button>
                            </Slot>
                        </TooltipTrigger>
                        <TooltipContent Side="PositionSide.Top">
                            <p>@Translations.Views_Index_GalleryTooltipAddToLibrary</p>
                        </TooltipContent>
                    </Tooltip>
                </CardContent>
            </Card>

            <!-- Separator -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GallerySeparatorTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GallerySeparatorDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-1">
                        <h4 class="text-sm leading-none font-medium">@Translations.Views_Index_GallerySeparatorHeading</h4>
                        <p class="text-muted-foreground text-sm">@Translations.Views_Index_GallerySeparatorTagline</p>
                    </div>
                    <Separator ClassName="my-4"/>
                    <div class="flex h-5 items-center gap-4 text-sm">
                        <div>@Translations.Views_Index_GallerySeparatorBlog</div>
                        <Separator Orientation="SeparatorOrientation.Vertical"/>
                        <div>@Translations.Views_Index_GallerySeparatorDocs</div>
                        <Separator Orientation="SeparatorOrientation.Vertical"/>
                        <div>@Translations.Views_Index_GallerySeparatorSource</div>
                    </div>
                </CardContent>
            </Card>

            <!-- Spinner -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GallerySpinnerTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GallerySpinnerDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Item Variant="ItemVariant.Muted">
                        <ItemMedia>
                            <Spinner/>
                        </ItemMedia>
                        <ItemContent>
                            <ItemTitle>@Translations.Views_Index_GallerySpinnerProcessing</ItemTitle>
                        </ItemContent>
                        <ItemContent ClassName="flex-none justify-end">
                            <span class="text-sm tabular-nums">$100.00</span>
                        </ItemContent>
                    </Item>
                </CardContent>
            </Card>

            <!-- Select -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GallerySelectTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GallerySelectDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Select>
                        <SelectTrigger ClassName="w-full">
                            <SelectValue Placeholder="@Translations.Views_Index_GallerySelectPlaceholder"/>
                        </SelectTrigger>
                        <SelectContent>
                            <SelectGroup>
                                <SelectLabel>@Translations.Views_Index_GallerySelectFruitsLabel</SelectLabel>
                                <SelectItem Value="apple">@Translations.Views_Index_GallerySelectApple</SelectItem>
                                <SelectItem Value="banana">@Translations.Views_Index_GallerySelectBanana</SelectItem>
                                <SelectItem Value="blueberry">@Translations.Views_Index_GallerySelectBlueberry</SelectItem>
                                <SelectItem Value="grapes">@Translations.Views_Index_GallerySelectGrapes</SelectItem>
                                <SelectItem Value="pineapple">@Translations.Views_Index_GallerySelectPineapple</SelectItem>
                            </SelectGroup>
                        </SelectContent>
                    </Select>
                </CardContent>
            </Card>

            <!-- Pagination -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryPaginationTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryPaginationDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Pagination>
                        <PaginationContent>
                            <PaginationItem>
                                <PaginationPrevious href="#"/>
                            </PaginationItem>
                            <PaginationItem>
                                <PaginationLink href="#">1</PaginationLink>
                            </PaginationItem>
                            <PaginationItem>
                                <PaginationLink href="#" IsActive="true">2</PaginationLink>
                            </PaginationItem>
                            <PaginationItem>
                                <PaginationLink href="#">3</PaginationLink>
                            </PaginationItem>
                            <PaginationItem>
                                <PaginationEllipsis/>
                            </PaginationItem>
                            <PaginationItem>
                                <PaginationNext href="#"/>
                            </PaginationItem>
                        </PaginationContent>
                    </Pagination>
                </CardContent>
            </Card>

            <!-- Toggle -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryToggleTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryToggleDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Toggle
                        aria-label="@Translations.Views_Index_GalleryToggleBookmarkAria"
                        Variant="ToggleVariant.Outline"
                        ClassName="data-[state=on]:bg-transparent data-[state=on]:*:[svg]:fill-violet-500 data-[state=on]:*:[svg]:stroke-violet-500">
                        <BookmarkIcon/>
                        @Translations.Views_Index_GalleryToggleBookmark
                    </Toggle>
                </CardContent>
            </Card>

            <!-- Item -->
            <Card>
                <CardHeader>
                    <CardTitle>@Translations.Views_Index_GalleryItemTitle</CardTitle>
                    <CardDescription>@Translations.Views_Index_GalleryItemDescription</CardDescription>
                </CardHeader>
                <CardContent>
                    <Item Variant="ItemVariant.Muted">
                        <ItemMedia Variant="ItemMediaVariant.Icon">
                            <BadgeCheckIcon ClassName="size-4"/>
                        </ItemMedia>
                        <ItemContent>
                            <ItemTitle>@Translations.Views_Index_GalleryItemVerifiedTitle</ItemTitle>
                            <ItemDescription>@Translations.Views_Index_GalleryItemVerifiedDescription</ItemDescription>
                        </ItemContent>
                        <ItemActions>
                            <ChevronRightIcon ClassName="size-4"/>
                        </ItemActions>
                    </Item>
                </CardContent>
            </Card>

        </div>
    </section>

    <!-- Quick start -->
    <section class="mt-24">
        <div class="mx-auto max-w-2xl text-center">
            <div class="text-sm font-semibold tracking-widest text-violet-400 uppercase">@Translations.Views_Index_QuickStart_Eyebrow</div>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">@Translations.Views_Index_QuickStart_Title</h2>
            <p class="mt-4 text-muted-foreground">
                @Translations.Views_Index_QuickStart_Description
                <a href="/installation" class="text-violet-400 underline-offset-4 hover:underline">@Translations.Views_Index_QuickStart_InstallationPage</a>.
            </p>
        </div>

        <div class="mt-12 grid gap-4 lg:grid-cols-2">

            <Card>
                <CardHeader>
                    <CardAction>
                        <div
