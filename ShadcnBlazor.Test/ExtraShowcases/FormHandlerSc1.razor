@using System.ComponentModel.DataAnnotations
@using ShadcnBlazor.Extras.Forms
@using ShadcnBlazor.Extras.Toasts
@using ShadcnBlazor.Inputs

@inject ToastService ToastService

<EnhancedEditForm OnValidSubmit="OnValidSubmit" Model="Model">
    <div class="flex flex-col gap-6">
        
        <DataAnnotationsValidator/>
        <FormValidationSummary />
                    
        <div class="grid gap-2">
            <Label for="email">Email</Label>
            <TextInputField
                @bind-Value="Model.Email"
                id="email"
                Type="email"
                placeholder="m@example.com"/>
        </div>

        <div class="grid gap-2">
            <Label for="email">Username</Label>
            <TextInputField
                @bind-Value="Model.Username"
                id="username"
                Type="text"
                placeholder="example_user"/>
        </div>
        
        <SubmitButton>Submit</SubmitButton>
    </div>
</EnhancedEditForm>

@code
{
    private FormModel Model = new();
    
    public record FormModel
    {
        [Required]
        [MinLength(3)]
        [MaxLength(32)]
        public string Username { get; set; }
    
        [Required]
        [EmailAddress]
        public string Email { get; set; }
    }

    private async Task<bool> OnValidSubmit(EditContext editContext, ValidationMessageStore messageStore)
    {
        await ToastService.SuccessAsync("Form submission", "Form submission was successful");
        return true;
    }
}
