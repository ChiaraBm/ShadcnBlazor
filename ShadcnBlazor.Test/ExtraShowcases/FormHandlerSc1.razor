@using System.ComponentModel.DataAnnotations
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.FormHandlers
@using ShadcnBlazor.Extras.Toasts
@using ShadcnBlazor.Inputs

@inject ToastService ToastService

<FormHandler @ref="Form" OnValidSubmit="OnSubmitAsync" Model="Model">
    <div class="flex flex-col gap-6">
                    
        <FormValidationSummary />
                    
        <div class="grid gap-2">
            <Label for="email">Email</Label>
            <TextInputField
                @bind-Value="Model.Email"
                id="email"
                Type="email"
                placeholder="m@example.com"/>
        </div>

        <div class="grid gap-2">
            <Label for="email">Username</Label>
            <TextInputField
                @bind-Value="Model.Username"
                id="username"
                Type="text"
                placeholder="example_user"/>
        </div>
        
        <Button @onclick="Form.SubmitAsync">Submit</Button>
    </div>
</FormHandler>

@code
{
    private FormHandler Form;
    private FormModel Model = new();

    private async Task OnSubmitAsync() => await ToastService.SuccessAsync("Form submission", "Form submission was successful");
    
    public record FormModel
    {
        [Required]
        [MinLength(3)]
        [MaxLength(32)]
        public string Username { get; set; }
    
        [Required]
        [EmailAddress]
        public string Email { get; set; }
    }
}
