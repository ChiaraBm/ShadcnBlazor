@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.AlertDialogs

@inject AlertDialogService AlertDialogService

<Button Variant="ButtonVariant.Outline" @onclick="LaunchConfirmAsync">
    Confirm
</Button>

@code
{
    private async Task LaunchConfirmAsync()
    {
        await AlertDialogService.ConfirmAsync(
            "Are you absolutely sure?",
            "This action cannot be undone. This will permanently delete your account and remove your data from our servers.",
            async () =>
            {
                await Task.Delay(1500);

                await AlertDialogService.ConfirmDangerAsync(
                    "Are you really sure???",
                    "I just wanted to show of the confirm danger variant :). Just press confirm again",
                    async () =>
                    {
                        await AlertDialogService.InfoAsync("Operation has been performed", "Something. I dont fucking know anymore");
                        await AlertDialogService.SuccessAsync("Operation has been performed", "Something. I dont fucking know anymore");
                        await AlertDialogService.WarningAsync("Operation has been performed", "Something. I dont fucking know anymore");
                        await AlertDialogService.ErrorAsync("Operation has been performed", "Something. I dont fucking know anymore");
                    }
                );
            }
        );
    }
}