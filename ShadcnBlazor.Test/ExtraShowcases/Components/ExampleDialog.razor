@using ShadcnBlazor.Dialogs
@using ShadcnBlazor.Inputs
@using ShadcnBlazor.Labels
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.AlertDialogs
@using ShadcnBlazor.Extras.Dialogs

@inherits DialogBase

@inject AlertDialogService AlertDialogService

<DialogHeader>
    <DialogTitle>@Translations.ExtraShowcases_Components_ExampleDialog_Title</DialogTitle>
    <DialogDescription>
        @Translations.ExtraShowcases_Components_ExampleDialog_Description
    </DialogDescription>
</DialogHeader>
<div class="space-y-2">
    <Label for="feedback">@Translations.ExtraShowcases_Components_ExampleDialog_FeedbackLabel</Label>
    <TextareaField
          ClassName="min-h-[120px]"
          id="feedback"
          placeholder="@Translations.ExtraShowcases_Components_ExampleDialog_FeedbackPlaceholder"/>
</div>
<DialogFooter>
    <DialogClose>
        <Slot>
            <Button Type="button" Variant="ButtonVariant.Outline" @attributes="context">
                @Translations.ExtraShowcases_Components_ExampleDialog_Cancel
            </Button>
        </Slot>
    </DialogClose>
    <Button @onclick="OnSubmitAsync" Type="button">
        @Translations.ExtraShowcases_Components_ExampleDialog_Submit
    </Button>
</DialogFooter>

@code
{
    private async Task OnSubmitAsync()
    {
        await AlertDialogService.InfoAsync(Translations.ExtraShowcases_Components_ExampleDialog_SubmittedTitle, Translations.ExtraShowcases_Components_ExampleDialog_SubmittedDescription);
        await Dialog.CloseAsync();
    }
}
