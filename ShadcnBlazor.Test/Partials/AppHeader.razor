@using ShadcnBlazor.Sidebars
@using ShadcnBlazor.Buttons

<header
    class="flex h-(--header-height) shrink-0 items-center gap-2 border-b transition-[width,height] ease-linear group-has-data-[collapsible=icon]/sidebar-wrapper:h-(--header-height)"
    style="--header-height: calc(var(--spacing) * 12)">
    <div class="flex w-full items-center gap-1 px-4 lg:gap-2 lg:px-6">
        <SidebarTrigger ClassName="-ml-1"/>
        <div class="ml-auto flex items-center gap-2">
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" ClassName="hidden sm:flex dark:text-foreground">
                <Slot>
                    <a href="https://github.com/ChiaraBm/ShadcnBlazor">
                        <img
                            alt="Github"
                            src="_content/ShadcnBlazor.Test/assets/github.png"
                            width="30px"
                            height="30px"
                            class=""
                        />
                    </a>
                    <a
                        href="/installation"
                        @attributes="context">
                        @Translations.Partials_AppHeader_GetStarted
                    </a>
                </Slot>
            </Button>
        </div>
    </div>
</header>