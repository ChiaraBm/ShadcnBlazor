@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.AlertDialogs
@using ShadcnBlazor.Extras.Alerts

@inject AlertService AlertService

<Button Variant="ButtonVariant.Outline" @onclick="LaunchAsync">
    Launch
</Button>

<Button Variant="ButtonVariant.Outline" @onclick="Launch2Async">
    Launch 2
</Button>

@code
{
    private async Task LaunchAsync()
    {
        await AlertService.InfoAsync("Operation has been performed", "Something. I dont fucking know anymore");
        await AlertService.SuccessAsync("Operation has been performed", "Something. I dont fucking know anymore");
        await AlertService.WarningAsync("Operation has been performed", "Something. I dont fucking know anymore");
        await AlertService.ErrorAsync("Operation has been performed", "Something. I dont fucking know anymore");
    }

    private async Task Launch2Async()
    {
        await AlertService.ErrorAsync("Operation has been performed", "I will auto hide", 3000);
    }
}