@using ShadcnBlazor.Alerts
@using ShadcnBlazor.Buttons

<Alert ClassName="w-full max-w-lg border-green-600/80 bg-green-600/5 text-green-600">
    <div class="col-span-2 flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
            <AlertTitle>Deployment complete</AlertTitle>
            <AlertDescription ClassName="text-green-600/80">
                Your project is live and ready to share.
            </AlertDescription>
        </div>
        <div class="flex shrink-0 gap-2">
            <Button
                ClassName="bg-green-600 text-white hover:bg-green-600/90"
                Size="ButtonSize.Sm"
                Variant="ButtonVariant.Default"
            >
                View project
            </Button>
            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Dismiss
            </Button>
        </div>
    </div>
</Alert>
