@using ShadcnBlazor.Alerts
@using ShadcnBlazor.Buttons

<Alert ClassName="w-full max-w-lg border-blue-600/80 bg-blue-600/5 text-blue-600">
    <div class="col-span-2 flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
            <AlertTitle>Heads up</AlertTitle>
            <AlertDescription ClassName="text-blue-600/80">
                The new reporting dashboard is still in beta. Some charts may load slowly while we finish tuning performance.
            </AlertDescription>
        </div>
        <div class="flex shrink-0 gap-2">
            <Button ClassName="bg-blue-600 text-white hover:bg-blue-600/90" Size="ButtonSize.Sm" Variant="ButtonVariant.Default">
                View docs
            </Button>
            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Got it
            </Button>
        </div>
    </div>
</Alert>
