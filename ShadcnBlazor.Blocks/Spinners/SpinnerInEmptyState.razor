@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Emptys
@using ShadcnBlazor.Spinners

<Empty ClassName="w-full">
    <EmptyHeader>
        <EmptyMedia Variant="EmptyMediaVariant.Icon">
            <Spinner />
        </EmptyMedia>
        <EmptyTitle>Generating your report</EmptyTitle>
        <EmptyDescription>
            This can take a moment. Please keep this tab open while we work on it.
        </EmptyDescription>
    </EmptyHeader>
    <EmptyContent>
        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
            Close
        </Button>
    </EmptyContent>
</Empty>
