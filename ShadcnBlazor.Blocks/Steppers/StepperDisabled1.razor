@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.Steppers

<Stepper DefaultValue="profile" ClassName="w-full max-w-md">
    <StepperList>
        @foreach (var step in Steps)
        {
            <StepperItem Value="@step.Value" Disabled="@step.Disabled" @key="step.Value">
                <StepperTrigger>
                    <StepperIndicator/>
                    <StepperTitle>@step.Title</StepperTitle>
                </StepperTrigger>
                <StepperSeparator ClassName="mx-3"/>
            </StepperItem>
        }
    </StepperList>
    @foreach (var step in Steps)
    {
        <StepperContent Value="@step.Value" @key="step.Value" ClassName="rounded-md border p-4 text-sm">
            @step.Body
        </StepperContent>
    }
    <div class="flex justify-between">
        <StepperPrev>
            <Slot>
                <Button Variant="ButtonVariant.Outline" @attributes="context">Previous</Button>
            </Slot>
        </StepperPrev>
        <StepperNext>
            <Slot>
                <Button @attributes="context">Next</Button>
            </Slot>
        </StepperNext>
    </div>
</Stepper>

@code
{
    private static readonly Step[] Steps =
    [
        new("profile", "Profile", "Enter your account details to continue.", false),
        new("team", "Team", "Choose a plan and invite members.", false),
        new("billing", "Billing", "Add a payment method.", true),
        new("complete", "Complete", "Setup finished.", true)
    ];

    record Step(string Value, string Title, string Body, bool Disabled);
}
