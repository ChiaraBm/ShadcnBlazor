@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.Steppers
@using ShadcnBlazor.Progresses

<div class="flex w-full max-w-md flex-col gap-4">
    <div class="space-y-2">
        <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">Overall progress</span>
            <span class="font-medium">@ProgressPercent%</span>
        </div>
        <Progress Value="@ProgressPercent" Max="100"/>
    </div>
    <Stepper @ref="_stepper">
        <StepperList>
            @foreach (var step in Steps)
            {
                <StepperItem Value="@step.Value" @key="step.Value">
                    <StepperTrigger>
                        <StepperIndicator/>
                        <StepperTitle>@step.Title</StepperTitle>
                    </StepperTrigger>
                    <StepperSeparator ClassName="mx-3"/>
                </StepperItem>
            }
        </StepperList>
        <div class="mt-2 flex justify-between">
            <StepperPrev>
                <Slot>
                    <Button Variant="ButtonVariant.Outline" @attributes="context">Previous</Button>
                </Slot>
            </StepperPrev>
            <StepperNext>
                <Slot>
                    <Button @attributes="context">Next</Button>
                </Slot>
            </StepperNext>
        </div>
    </Stepper>
</div>

@code
{
    private Stepper? _stepper;
    private int ProgressPercent => ((_stepper?.Position ?? 0) + 1) * 100 / Steps.Length;

    private static readonly Step[] Steps =
    [
        new("discover", "Discover"),
        new("design", "Design"),
        new("develop", "Develop"),
        new("deliver", "Deliver")
    ];

    record Step(string Value, string Title);
}
