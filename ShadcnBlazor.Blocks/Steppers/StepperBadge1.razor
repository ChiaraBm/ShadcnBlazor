@using ShadcnBlazor.Badges
@using ShadcnBlazor.Extras.Steppers

<Stepper DefaultValue="identity" ClassName="w-full max-w-3xl">
    <StepperList>
        @foreach (var step in Steps)
        {
            <StepperItem Value="@step.Value" @key="step.Value">
                <StepperTrigger>
                    <StepperIndicator/>
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2">
                            <StepperTitle>@step.Title</StepperTitle>
                            <Badge Variant="@step.Variant">@step.Badge</Badge>
                        </div>
                        <StepperDescription>@step.Description</StepperDescription>
                    </div>
                </StepperTrigger>
                <StepperSeparator ClassName="mx-4"/>
            </StepperItem>
        }
    </StepperList>
</Stepper>

@code
{
    private static readonly Step[] Steps =
    [
        new("identity", "Identity", "Name and handle", "Required", BadgeVariant.Primary),
        new("security", "Security", "Password and 2FA", "Required", BadgeVariant.Outline),
        new("profile", "Profile", "Bio and links", "Optional", BadgeVariant.Secondary),
    ];

    record Step(string Value, string Title, string Description, string Badge, BadgeVariant Variant);
}
