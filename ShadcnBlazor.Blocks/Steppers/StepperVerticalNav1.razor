@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.Steppers

<Stepper DefaultValue="source" Orientation="StepperOrientation.Vertical" ClassName="w-full max-w-lg">
    <StepperList>
        @foreach (var step in Steps)
        {
            <StepperItem Value="@step.Value" @key="step.Value">
                <StepperTrigger ClassName="not-last:pb-6">
                    <StepperIndicator/>
                    <div class="flex flex-col gap-1">
                        <StepperTitle>@step.Title</StepperTitle>
                        <StepperDescription>@step.Description</StepperDescription>
                    </div>
                </StepperTrigger>
                <StepperSeparator ClassName="absolute inset-y-0 top-5 left-3.5 -z-10 -order-1 h-full -translate-x-1/2"/>
            </StepperItem>
        }
    </StepperList>
    <div class="flex flex-1 flex-col gap-4">
        @foreach (var step in Steps)
        {
            <StepperContent Value="@step.Value" @key="step.Value" ClassName="rounded-lg border bg-card p-4">
                <h4 class="font-semibold">@step.Title</h4>
                <p class="mt-1 text-sm text-muted-foreground">@step.Description</p>
            </StepperContent>
        }
        <div class="flex justify-between">
            <StepperPrev>
                <Slot>
                    <Button Variant="ButtonVariant.Outline" @attributes="context">Previous</Button>
                </Slot>
            </StepperPrev>
            <StepperNext>
                <Slot>
                    <Button @attributes="context">Next</Button>
                </Slot>
            </StepperNext>
        </div>
    </div>
</Stepper>

@code
{
    private static readonly Step[] Steps =
    [
        new("source", "Source", "Point at the data"),
        new("schema", "Schema", "Map the columns"),
        new("run", "Run", "Confirm and start")
    ];

    record Step(string Value, string Title, string Description);
}
