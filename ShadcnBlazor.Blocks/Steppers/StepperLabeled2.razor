@using ShadcnBlazor.Extras.Steppers

<Stepper DefaultValue="owners" ClassName="w-full max-w-3xl">
    <StepperList>
        @foreach (var step in Steps)
        {
            <StepperItem Value="@step.Value" @key="step.Value">
                <StepperTrigger>
                    <StepperIndicator/>
                    <div class="flex flex-col gap-px">
                        <StepperTitle>@step.Title</StepperTitle>
                        <StepperDescription>@step.Description</StepperDescription>
                    </div>
                </StepperTrigger>
                <StepperSeparator ClassName="mx-4"/>
            </StepperItem>
        }
    </StepperList>
</Stepper>

@code
{
    private static readonly Step[] Steps =
    [
        new("scope", "Scope", "What we're building"),
        new("owners", "Owners", "Assign leads"),
        new("timeline", "Timeline", "Set milestones"),
        new("kickoff", "Kickoff", "Start the project")
    ];

    record Step(string Value, string Title, string Description);
}
