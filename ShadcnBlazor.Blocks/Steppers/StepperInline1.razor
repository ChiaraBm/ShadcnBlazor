@using ShadcnBlazor.Extras.Steppers

<Stepper DefaultValue="shipping" ClassName="w-full max-w-lg">
    <StepperList>
        @foreach (var step in Steps)
        {
            <StepperItem Value="@step.Value" @key="step.Value">
                <StepperTrigger ClassName="flex-col gap-2">
                    <StepperIndicator/>
                    <div class="flex flex-col items-center gap-0.5 text-center">
                        <StepperTitle>@step.Title</StepperTitle>
                        <StepperDescription>@step.Description</StepperDescription>
                    </div>
                </StepperTrigger>
                <StepperSeparator ClassName="mx-2 mb-8"/>
            </StepperItem>
        }
    </StepperList>
</Stepper>

@code
{
    private static readonly Step[] Steps =
    [
        new("summary", "Summary", "Items"),
        new("shipping", "Shipping", "Where"),
        new("taxes", "Taxes", "Charges"),
        new("submit", "Submit", "Place it")
    ];

    record Step(string Value, string Title, string Description);
}
