@using ShadcnBlazor.Extras.Steppers

<Stepper DefaultValue="triage" ClassName="w-full max-w-2xl">
    <StepperList>
        @foreach (var step in Steps)
        {
            <StepperItem Value="@step.Value" @key="step.Value">
                <StepperTrigger ClassName="flex-col gap-2">
                    <StepperIndicator/>
                    <StepperTitle>@step.Title</StepperTitle>
                </StepperTrigger>
                <StepperSeparator ClassName="mx-2 h-1.5 rounded-full"/>
            </StepperItem>
        }
    </StepperList>
</Stepper>

@code
{
    private static readonly Step[] Steps =
    [
        new("submitted", "Submitted"),
        new("triage", "Triage"),
        new("decision", "Decision"),
        new("closed", "Closed")
    ];

    record Step(string Value, string Title);
}
