@using LucideBlazor
@using ShadcnBlazor.Accordions

<Accordion Type="AccordionType.Single"
           DefaultValue="reports"
           ClassName="w-full max-w-md -space-y-px">
    <AccordionItem Value="reports"
                   ClassName="overflow-hidden border bg-background px-4 first:rounded-t-lg last:rounded-b-lg last:border-b">
        <AccordionTrigger ClassName="group hover:no-underline [&>svg]:hidden">
            <div class="flex w-full items-center justify-between">
                <div class="flex items-center gap-3">
                    <FileTextIcon ClassName="size-4 text-muted-foreground" />
                    <div class="flex flex-col items-start text-left">
                        <span>Reports</span>
                        <span class="text-sm text-muted-foreground">Quarterly summaries</span>
                    </div>
                </div>
                <div class="relative size-4 shrink-0">
                    <PlusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground transition-opacity duration-200 group-data-[state=open]:opacity-0"/>
                    <MinusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground opacity-0 transition-opacity duration-200 group-data-[state=open]:opacity-100"/>
                </div>
            </div>
        </AccordionTrigger>
        <AccordionContent ClassName="ps-7">
            <p class="text-muted-foreground">Generate revenue, usage, and churn reports on a schedule, or export them on demand in CSV and PDF formats.</p>
        </AccordionContent>
    </AccordionItem>

    <AccordionItem Value="projects"
                   ClassName="overflow-hidden border bg-background px-4 first:rounded-t-lg last:rounded-b-lg last:border-b">
        <AccordionTrigger ClassName="group hover:no-underline [&>svg]:hidden">
            <div class="flex w-full items-center justify-between">
                <div class="flex items-center gap-3">
                    <FolderIcon ClassName="size-4 text-muted-foreground" />
                    <div class="flex flex-col items-start text-left">
                        <span>Projects</span>
                        <span class="text-sm text-muted-foreground">Active workspaces</span>
                    </div>
                </div>
                <div class="relative size-4 shrink-0">
                    <PlusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground transition-opacity duration-200 group-data-[state=open]:opacity-0"/>
                    <MinusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground opacity-0 transition-opacity duration-200 group-data-[state=open]:opacity-100"/>
                </div>
            </div>
        </AccordionTrigger>
        <AccordionContent ClassName="ps-7">
            <p class="text-muted-foreground">Organize work into projects with their own boards, milestones, and integrations, and move them between workspaces as needs change.</p>
        </AccordionContent>
    </AccordionItem>

    <AccordionItem Value="preferences"
                   ClassName="overflow-hidden border bg-background px-4 first:rounded-t-lg last:rounded-b-lg last:border-b">
        <AccordionTrigger ClassName="group hover:no-underline [&>svg]:hidden">
            <div class="flex w-full items-center justify-between">
                <div class="flex items-center gap-3">
                    <SettingsIcon ClassName="size-4 text-muted-foreground" />
                    <div class="flex flex-col items-start text-left">
                        <span>Preferences</span>
                        <span class="text-sm text-muted-foreground">Workspace defaults</span>
                    </div>
                </div>
                <div class="relative size-4 shrink-0">
                    <PlusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground transition-opacity duration-200 group-data-[state=open]:opacity-0"/>
                    <MinusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground opacity-0 transition-opacity duration-200 group-data-[state=open]:opacity-100"/>
                </div>
            </div>
        </AccordionTrigger>
        <AccordionContent ClassName="ps-7">
            <p class="text-muted-foreground">Set default assignees, time zones, and notification rules so every new project starts with the right configuration.</p>
        </AccordionContent>
    </AccordionItem>

    <AccordionItem Value="members"
                   ClassName="overflow-hidden border bg-background px-4 first:rounded-t-lg last:rounded-b-lg last:border-b">
        <AccordionTrigger ClassName="group hover:no-underline [&>svg]:hidden">
            <div class="flex w-full items-center justify-between">
                <div class="flex items-center gap-3">
                    <UsersIcon ClassName="size-4 text-muted-foreground" />
                    <div class="flex flex-col items-start text-left">
                        <span>Members</span>
                        <span class="text-sm text-muted-foreground">Roles and access</span>
                    </div>
                </div>
                <div class="relative size-4 shrink-0">
                    <PlusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground transition-opacity duration-200 group-data-[state=open]:opacity-0"/>
                    <MinusIcon
                        ClassName="absolute inset-0 size-4 text-muted-foreground opacity-0 transition-opacity duration-200 group-data-[state=open]:opacity-100"/>
                </div>
            </div>
        </AccordionTrigger>
        <AccordionContent ClassName="ps-7">
            <p class="text-muted-foreground">Invite teammates, assign roles, and control who can view, edit, or administer each project and workspace.</p>
        </AccordionContent>
    </AccordionItem>
</Accordion>
