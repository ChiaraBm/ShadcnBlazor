@using LucideBlazor
@using ShadcnBlazor.Alerts

@inherits ShadcnBase

@if (!Handler.IsValid)
{
    <Alert Variant="AlertVariant.Destructive" ClassName="@ClassName" Props="Props">
        <TriangleAlertIcon />
        <AlertTitle>Following validation errors were found:</AlertTitle>
        <AlertDescription>
            <ul class="list-inside list-disc text-sm">
                @foreach (var result in Handler.ValidationResults)
                {
                    <li>
                        <b>@string.Join(", ", result.MemberNames)</b>: @result.ErrorMessage
                    </li>
                }
            </ul>
        </AlertDescription>
    </Alert>
}

@code
{
    [CascadingParameter] public FormHandler Handler { get; set; }
}
