@using LucideBlazor
@using ShadcnBlazor.Alerts
@using ShadcnBlazor.Buttons

@inherits AlertBase

<Alert ClassName="w-full flex flex-row items-center gap-3 border-blue-500/80 bg-blue-500/5 text-blue-500">
    <div class="flex shrink-0 items-center">
        <InfoIcon ClassName="size-6 text-blue-500/60" />
    </div>
    <div class="flex flex-1 items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
            <AlertTitle>@Title</AlertTitle>
            <AlertDescription ClassName="text-blue-500/80">
                @Description
            </AlertDescription>
        </div>
        <div class="flex items-center shrink-0 gap-2">
            <Button @onclick="CloseAsync" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Dismiss
            </Button>
        </div>
    </div>
</Alert>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
