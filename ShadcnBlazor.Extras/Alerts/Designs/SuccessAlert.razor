@using ShadcnBlazor.Alerts
@using ShadcnBlazor.Buttons

@inherits AlertBase

<Alert ClassName="w-full flex flex-row items-center gap-3 border-emerald-500/80 bg-emerald-500/5 text-emerald-500">
    <div class="flex shrink-0 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="lucide lucide-circle-check-big-icon lucide-circle-check-big size-6 text-emerald-500/60">
            <path d="M21.801 10A10 10 0 1 1 17 3.335"/>
            <path d="m9 11 3 3L22 4"/>
        </svg>
    </div>
    <div class="flex flex-1 items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
            <AlertTitle>@Title</AlertTitle>
            <AlertDescription ClassName="text-emerald-500/80">
                @Description
            </AlertDescription>
        </div>
        <div class="flex items-center shrink-0 gap-2">
            <Button @onclick="CloseAsync" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Dismiss
            </Button>
        </div>
    </div>
</Alert>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
