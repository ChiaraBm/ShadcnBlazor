@using System.Text
@using LucideBlazor
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Cards
@using ShadcnBlazor.Extras.AlertDialogs
@using ShadcnBlazor.Extras.Common
@using ShadcnBlazor.Extras.Editors
@using ShadcnBlazor.Extras.FileManagers.Abstractions
@using ShadcnBlazor.Extras.Toasts

@inject AlertDialogService AlertDialogService
@inject ToastService ToastService

<div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-4">
    <div class="col-span-1 flex items-center justify-center lg:justify-start">
        <Card ClassName="py-1.5">
            <CardContent ClassName="px-2.5">
                @FsEntry.Name (@(Formatter.FormatSize(FsEntry.Size)))
            </CardContent>
        </Card>
    </div>
    <div class="col-span-1 flex items-center justify-center lg:justify-end gap-1.5">
        <WButton OnClick="SaveAsync" disabled="@(!HasLoaded)" Variant="ButtonVariant.Default">
            <SaveIcon/>
            Save
        </WButton>
        <WButton OnClick="CloseAsync" Variant="ButtonVariant.Destructive">
            <XIcon/>
            Close
        </WButton>
    </div>
</div>

<LazyLoader Load="LoadAsync">
    <style>
        .cm-editor {
            max-height: 400px;
            min-height: 400px;
        }
    </style>

    <Editor @ref="Editor" Language="Language" InitialValue="@LastKnownContent"/>
</LazyLoader>

@code
{
    [Parameter] public IFsAccess FsAccess { get; set; }
    [Parameter] public IFileManager FileManager { get; set; }
    [Parameter] public string WorkingDirectory { get; set; }
    [Parameter] public FsEntry FsEntry { get; set; }

    private string LastKnownContent;
    private EditorLanguage Language;
    private Editor Editor;
    private bool HasLoaded;

    private async Task LoadAsync(LazyLoader lazyLoader)
    {
        await lazyLoader.SetTextAsync("Loading contents");

        await using var stream = await FsAccess.ReadAsync(
            UnixPath.Combine(WorkingDirectory, FsEntry.Name)
        );

        using var sr = new StreamReader(stream, Encoding.UTF8);

        LastKnownContent = await sr.ReadToEndAsync();

        Language = EditorHelper.GetLanguage(
            EditorHelper.GetExtension(FsEntry.Name)
        );

        HasLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        var currentContent = await Editor.GetValueAsync();
        LastKnownContent = currentContent;

        await using var memoryStream = new MemoryStream(
            Encoding.UTF8.GetBytes(currentContent)
        );

        await FsAccess.WriteAsync(
            UnixPath.Combine(WorkingDirectory, FsEntry.Name),
            memoryStream
        );

        await ToastService.SuccessAsync(
            "File Save",
            "Successfully saved changes"
        );
    }

    private async Task CloseAsync()
    {
        var currentContent = await Editor.GetValueAsync();

        if (currentContent != LastKnownContent)
        {
            await AlertDialogService.ConfirmDangerAsync(
                "Unsaved changes",
                "You have unsaved changes. Do you really want to quit without saving?",
                FileManager.CloseOpenWindowAsync
            );
        }
        else
            await FileManager.CloseOpenWindowAsync();
    }
}
