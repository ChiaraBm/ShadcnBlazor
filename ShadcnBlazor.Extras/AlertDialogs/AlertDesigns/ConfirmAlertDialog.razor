@using ShadcnBlazor.AlertDialogs
@using ShadcnBlazor.Extras.Common

@inherits AlertDialogBase

<AlertDialogHeader>
    <AlertDialogTitle>
        @Title
    </AlertDialogTitle>
    <AlertDialogDescription>
        @Description
    </AlertDialogDescription>
</AlertDialogHeader>
<AlertDialogFooter>
    <AlertDialogCancel>Cancel</AlertDialogCancel>
    <WButtom OnClick="CallbackAsync">Confirm</WButtom>
</AlertDialogFooter>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
    [Parameter] public Func<Task> OnConfirm { get; set; }

    private async Task CallbackAsync()
    {
        await OnConfirm.Invoke();
        await AlertDialog.CloseAsync();
    }
}
