@using ShadcnBlazor.AlertDialogs
@using ShadcnBlazor.Extras.Common

@inherits AlertDialogBase

<AlertDialogHeader>
    <AlertDialogTitle>
        @Title
    </AlertDialogTitle>
    <AlertDialogDescription>
        @Description
    </AlertDialogDescription>
</AlertDialogHeader>
<AlertDialogFooter>
    <AlertDialogCancel>@Translations.AlertDialogs_ConfirmAlertDialog_Cancel</AlertDialogCancel>
    <WButton OnClick="CallbackAsync">@Translations.AlertDialogs_ConfirmAlertDialog_Confirm</WButton>
</AlertDialogFooter>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
    [Parameter] public Func<Task> OnConfirm { get; set; }

    private async Task CallbackAsync()
    {
        await OnConfirm.Invoke();
        await AlertDialog.CloseAsync();
    }
}
