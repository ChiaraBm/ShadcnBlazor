@using LucideBlazor
@using ShadcnBlazor.AlertDialogs

@inherits AlertDialogBase

<AlertDialogHeader ClassName="items-center">
    <div class="flex size-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900">
        <CircleCheckBigIcon ClassName="size-6 text-emerald-600 dark:text-emerald-400" />
    </div>
    <AlertDialogTitle>
        @Title
    </AlertDialogTitle>
    <AlertDialogDescription ClassName="text-center">
        @Description
    </AlertDialogDescription>
</AlertDialogHeader>
<AlertDialogFooter>
    <AlertDialogCancel>Close</AlertDialogCancel>
</AlertDialogFooter>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
