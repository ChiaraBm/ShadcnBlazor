@using LucideBlazor
@using ShadcnBlazor.Sonners

@inherits ToastBase

<div>
    <div class="flex size-8 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900">
        <InfoIcon ClassName="size-4 text-blue-600 dark:text-blue-400" />
    </div>
</div>

<SonnerHeader>
    <SonnerTitle>@Title</SonnerTitle>
    <SonnerDescription>@Description</SonnerDescription>
</SonnerHeader>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
