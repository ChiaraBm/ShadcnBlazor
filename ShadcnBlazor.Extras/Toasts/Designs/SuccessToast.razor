@using LucideBlazor
@using ShadcnBlazor.Sonners

@inherits ToastBase

<div class="flex size-8 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900">
    <CircleCheckBigIcon ClassName="size-4 text-emerald-600 dark:text-emerald-400" />
</div>

<SonnerHeader>
    <SonnerTitle>@Title</SonnerTitle>
    <SonnerDescription>@Description</SonnerDescription>
</SonnerHeader>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
