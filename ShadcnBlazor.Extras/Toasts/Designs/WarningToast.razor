@using LucideBlazor
@using ShadcnBlazor.Sonners

@inherits ToastBase

<div class="flex size-8 items-center justify-center rounded-full bg-yellow-100 dark:bg-yellow-900">
    <TriangleAlertIcon ClassName="size-4 text-yellow-600 dark:text-yellow-400" />
</div>

<SonnerHeader>
    <SonnerTitle>@Title</SonnerTitle>
    <SonnerDescription>@Description</SonnerDescription>
</SonnerHeader>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
