@using LucideBlazor
@using ShadcnBlazor.Sonners

@inherits ToastBase

<div>
    <div class="flex size-8 items-center justify-center rounded-full bg-red-100 dark:bg-red-900">
        <CircleXIcon ClassName="size-4 text-red-600 dark:text-red-400"/>
    </div>
</div>

<SonnerHeader>
    <SonnerTitle>@Title</SonnerTitle>
    <SonnerDescription>@Description</SonnerDescription>
</SonnerHeader>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
