@using ShadcnBlazor.Sonners

@inherits ToastBase

<div class="flex size-8 items-center justify-center rounded-full bg-red-100 dark:bg-red-900">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="lucide lucide-circle-x-icon lucide-circle-x size-4 text-red-600 dark:text-red-400">
        <circle cx="12" cy="12" r="10"/>
        <path d="m15 9-6 6"/>
        <path d="m9 9 6 6"/>
    </svg>
</div>

<SonnerHeader>
    <SonnerTitle>@Title</SonnerTitle>
    <SonnerDescription>@Description</SonnerDescription>
</SonnerHeader>

@code
{
    [Parameter] public string Title { get; set; }
    [Parameter] public string Description { get; set; }
}
