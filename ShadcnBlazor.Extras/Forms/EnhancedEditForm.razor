@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inherits ShadcnBase

@inject IJSRuntime JsRuntime

<EditForm id="@Id"
          EditContext="EditContext"
          OnValidSubmit="HandleValidSubmitAsync"
          OnInvalidSubmit="HandleInvalidSubmitAsync"
          class="@ClassName"
          @attributes="Props">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent.Invoke(context)
    </CascadingValue>
</EditForm>

@code
{
    [Parameter] public RenderFragment<EditContext> ChildContent { get; set; }

    [Parameter] public object Model { get; set; }
    [Parameter] public Func<EditContext, ValidationMessageStore, Task<bool>>? OnValidSubmit { get; set; }
    [Parameter] public Func<EditContext, ValidationMessageStore, Task<bool>>? OnInvalidSubmit { get; set; }
    [Parameter] public Func<EditContext, ValidationMessageStore, Task<bool>>? OnSubmit { get; set; }

    public bool IsProcessing { get; private set; }

    public EditContext EditContext { get; private set; }
    public ValidationMessageStore MessageStore { get; private set; }

    private string Id;

    protected override void OnInitialized()
    {
        Id = $"enhancedEditForm-{GetHashCode()}";
        
        EditContext = new EditContext(Model);
        MessageStore = new ValidationMessageStore(EditContext);
        
        EditContext.OnValidationRequested += (_, _) =>
        {
            MessageStore.Clear();
        };
    }

    // js required for manual submission https://github.com/dotnet/aspnetcore/issues/39574
    public async Task SubmitAsync()
     => await JsRuntime.InvokeVoidAsync("ShadcnBlazorExtras.submitForm", Id);

    private async Task HandleValidSubmitAsync()
    {
        IsProcessing = true;
        await InvokeAsync(StateHasChanged);

        if (OnSubmit != null)
        {
            var hasSucceeded = await OnSubmit.Invoke(EditContext, MessageStore);
            
            if(!hasSucceeded)
                EditContext.NotifyValidationStateChanged();
        }
        
        if (OnValidSubmit != null)
        {
            var hasSucceeded = await OnValidSubmit.Invoke(EditContext, MessageStore);
        
            if(!hasSucceeded)
                EditContext.NotifyValidationStateChanged();
        }
        
        IsProcessing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleInvalidSubmitAsync()
    {
        IsProcessing = true;
        await InvokeAsync(StateHasChanged);
        
        if (OnSubmit != null)
        {
            var hasSucceeded = await OnSubmit.Invoke(EditContext, MessageStore);
            
            if(!hasSucceeded)
                EditContext.NotifyValidationStateChanged();
        }
        
        if (OnInvalidSubmit != null)
        {
            var hasSucceeded = await OnInvalidSubmit.Invoke(EditContext, MessageStore);
            
            if(!hasSucceeded)
                EditContext.NotifyValidationStateChanged();
        }
        
        IsProcessing = false;
        await InvokeAsync(StateHasChanged);
    }
}