@inherits ShadcnBase

@if (Slot is not null)
{
    @Slot.Invoke(Attributes)
}
else
{
    <button data-slot="stepper-next"
            type="button"
            disabled="@IsDisabled"
            class="@Classes"
            @onclick="HandleClickAsync"
            @attributes="Props">
        @ChildContent
    </button>
}

@code
{
    [CascadingParameter] public Stepper Stepper { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public RenderFragment<Dictionary<string, object?>>? Slot { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool IsDisabled => Disabled || !Stepper.CanGoNext;

    private Dictionary<string, object?> Attributes;
    private string? Classes;

    protected override void OnParametersSet()
    {
        Attributes = new()
        {
            ["data-slot"] = "stepper-next",
            ["disabled"] = IsDisabled,
            ["onclick"] = EventCallback.Factory.Create(this, HandleClickAsync)
        };

        Classes = Cn(
            "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 not-disabled:cursor-pointer",
            ClassName
        );
    }

    private async Task HandleClickAsync()
    {
        if (IsDisabled)
            return;

        await Stepper.NextAsync();
    }
}
