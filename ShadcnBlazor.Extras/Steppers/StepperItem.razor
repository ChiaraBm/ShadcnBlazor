@inherits ShadcnBase

<div data-slot="stepper-item"
     data-state="@Stepper.GetState(Value).ToDataString()"
     data-disabled="@Disabled"
     data-orientation="@Stepper.Orientation.ToDataString()"
     class="@Classes"
     @attributes="Props">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code
{
    [CascadingParameter] public Stepper Stepper { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Completed { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? Classes;

    protected override void OnParametersSet()
    {
        Stepper.RegisterStep(Value, Completed);

        Classes = Cn(
            "relative flex items-center not-last:flex-1",
            Stepper.Orientation == StepperOrientation.Horizontal ? "flex-row" : "flex-col",
            ClassName
        );
    }
}