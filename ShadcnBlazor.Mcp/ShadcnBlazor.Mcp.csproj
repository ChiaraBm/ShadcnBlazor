<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <CoreDir Condition="'$(CoreDir)' == ''">../ShadcnBlazor</CoreDir>
    <ExtrasDir Condition="'$(ExtrasDir)' == ''">../ShadcnBlazor.Extras</ExtrasDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package sources are referenced data, not part of this project: keep them out of the IDE. -->
    <EmbeddedResource Include="$(CoreDir)/**/*.razor;$(CoreDir)/**/*.cs;$(CoreDir)/**/*.css;$(CoreDir)/**/*.js"
                      Exclude="$(CoreDir)/**/bin/**;$(CoreDir)/**/obj/**;$(CoreDir)/**/node_modules/**"
                      LogicalName="src/ShadcnBlazor/%(RecursiveDir)%(Filename)%(Extension)"
                      Visible="false" />
    <EmbeddedResource Include="$(ExtrasDir)/**/*.razor;$(ExtrasDir)/**/*.cs;$(ExtrasDir)/**/*.css;$(ExtrasDir)/**/*.js"
                      Exclude="$(ExtrasDir)/**/bin/**;$(ExtrasDir)/**/obj/**;$(ExtrasDir)/**/node_modules/**"
                      LogicalName="src/ShadcnBlazor.Extras/%(RecursiveDir)%(Filename)%(Extension)"
                      Visible="false" />
    <EmbeddedResource Include="Instructions/**/*.md"
                      LogicalName="instructions/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="$(CoreDir)/**;$(ExtrasDir)/**" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\index.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
      <DependentUpon>Dockerfile</DependentUpon>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="README.md" />
  </ItemGroup>

  <Target Name="ValidateEmbeddedContent" BeforeTargets="Build">
    <Warning Condition="!Exists('$(CoreDir)')" Text="CoreDir '$(CoreDir)' not found. No core package source will be embedded." />
    <Warning Condition="!Exists('$(ExtrasDir)')" Text="ExtrasDir '$(ExtrasDir)' not found. No extras package source will be embedded." />
  </Target>

</Project>
