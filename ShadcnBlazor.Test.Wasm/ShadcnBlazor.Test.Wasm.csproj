<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

        <WasmEnableSIMD>true</WasmEnableSIMD>
        <PublishTrimmed>true</PublishTrimmed>
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.19" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.19" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ShadcnBlazor.Test\ShadcnBlazor.Test.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>Docker\.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Styles\package-lock.json" />
      <_ContentIncludedByDefault Remove="Styles\package.json" />
      <_ContentIncludedByDefault Remove="Styles\shadcnblazor\classes.json" />
      <_ContentIncludedByDefault Remove="Styles\shadcnblazor\package.json" />
    </ItemGroup>
</Project>
